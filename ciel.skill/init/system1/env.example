# ~/.ciel/system1/env — laya-serve configuration.
# chmod 600 — contains the key; machine-local, never committed.
LAYA_HOST=127.0.0.1
LAYA_PORT=8765
LAYA_PRELOAD=1
LAYA_MODELS=english,typed-decisions
LAYA_THREADS=4
LAYA_API_KEY=<openssl rand -hex 24>
CIEL_SYSTEM1_MODEL=typed-decisions
# HF_TOKEN=              # optional: avoids unauthenticated HF hub rate limits
