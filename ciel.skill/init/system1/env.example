# Local Laya / System-1 configuration (machine-local, chmod 600)
LAYA_HOST=127.0.0.1
LAYA_PORT=8765
LAYA_PRELOAD=1
LAYA_MODELS=english,typed-decisions
# Checkpoints kept resident — default 2 matches the two preloaded above;
# below the routing set, every model switch pays a ~7s CPU reload.
LAYA_MAX_LOADED=2
# torch intra-op threads — cap at PHYSICAL cores; oversubscribing logical
# threads is a documented regression (2 on a 2C/4T box).
LAYA_THREADS=2
# Route unpinned typed-decision calls to the RLCD checkpoint — the base
# `english` checkpoint scores ~0.36 on typed decisions zero-shot, so this
# matters whenever CIEL_SYSTEM1_MODEL is unset.
LAYA_AUTO_TASK=1
# Idle checkpoint unload — default 0 (off). Any nonzero value re-incurs the
# multi-second reload on the next request after quiet periods.
LAYA_IDLE_UNLOAD_SECONDS=0
# Compute device — leave UNSET to auto-detect (cuda -> mps -> xpu -> cpu,
# with silent GPU->CPU fallback per checkpoint). Only pin to constrain a
# box, e.g. LAYA_DEVICE=cpu on a host whose GPU is reserved.
# LAYA_DEVICE=cuda
LAYA_API_KEY=<openssl rand -hex 24>
CIEL_SYSTEM1_MODE=active
# Pin the calibrated checkpoint for all asks (typed-decisions 0.766 acc vs
# english 0.362 on the typed-decisions benchmark — do NOT substitute for
# latency; tune residency/threads instead).
CIEL_SYSTEM1_MODEL=typed-decisions
# --- Hosted Jev failover (optional) ---------------------------------------
# When a hosted key is configured, hosted Jev is PRIMARY and the local
# daemon picks up any failure; a circuit breaker (hosted_state.json)
# makes laya primary until backoff expires — 401/402/403 trip 300s,
# 429 trips 60s, transport/5xx trip 30s. Set CIEL_SYSTEM1_HOSTED=off to
# disable hosted egress entirely; unset a hosted key to stay local-only.
# Hosted key chain: CIEL_SYSTEM1_HOSTED_KEY -> JEV_API_KEY ->
# CIEL_SYSTEM1_KEY (process env or this file; LAYA_API_KEY is never sent
# hosted).
# Official TypeSafe API (default): CIEL_SYSTEM1_HOSTED_URL=https://api.typesafe.ai
#   + JEV_API_KEY=apikey_...   (console.typesafe.ai/keys — 'apikey_' format)
# Unofficial proxy (paid third-party, NOT TypeSafe):
#   CIEL_SYSTEM1_HOSTED_URL=https://jev-agent.com + key jv_live_...
#   ...or point CIEL_SYSTEM1_URL at it directly to make it the sole engine.
# Hosted asks always send a Jev model id — CIEL_SYSTEM1_MODEL's checkpoint
# name is local-only (the API 400s on unknown models, 422s when absent).
# Valid ids per GET /v1/models: jev-latest (default), jev-preview.
# CIEL_SYSTEM1_HOSTED_MODEL=jev-latest

# Embedding backend for the semantic shortlist leg (route_choice /
# context_select). Default: the laya venv python + system1_embed.py
# helper. Point CIEL_SYSTEM1_EMBED_BIN at a native binary to replace it
# (invoked as `<bin> embed`, same {"task","candidates","k"} →
# {"names":[...]} stdin/stdout contract). CIEL_SYSTEM1_EMBED=0 disables
# the semantic leg entirely (lexical-only).
# CIEL_SYSTEM1_EMBED_BIN=/path/to/ciel-dev
# CIEL_SYSTEM1_EMBED=0
# Hosted has no /batch route — ask_batch serializes under one aggregate
# deadline (one billed call per state; late states resolve None).
# JEV_API_KEY=<apikey_...>
# CIEL_SYSTEM1_HOSTED=on
# Supply-chain pin (recommended): freeze the Hub revision AND verify every
# artifact's sha256 at load. Mismatched/tampered files refuse to load.
# Per-checkpoint map shape; JSON must be single-quoted in this file (bash
# strips unquoted " when sourcing).
# LAYA_REVISION=<snapshot sha>
# LAYA_SHA256_DIGESTS='{"english": {"model.safetensors": "…", "tokenizer/tokenizer.json": "…"}, "typed-decisions": {"model.safetensors": "…"}}'
# CPU autocast: only set on hardware with real bf16 support (AVX-512 BF16 /
# AMX or ARM); on older cores (e.g. Haswell) it is a ~3x REGRESSION.
# LAYA_CPU_AMP=bf16
