import struct

path = '/Volumes/SWITCH/switch/DBI_ENG/DBI.nro'
with open(path, 'rb') as f:
    data = f.read()

base = data.find(b'NRO0')
d = data[base:]
print(f"NRO data size: 0x{len(d):x}")

# NRO header
header_size = struct.unpack_from('<I', d, 0xC)[0]
text_size = struct.unpack_from('<I', d, 0x18)[0]
ro_size = struct.unpack_from('<I', d, 0x20)[0]
data_size = struct.unpack_from('<I', d, 0x28)[0]
print(f"Header: 0x{header_size:x}, Text: 0x{text_size:x}, Ro: 0x{ro_size:x}, Data: 0x{data_size:x}")

# The ASET section should be right after the segments
# Total NRO size = header + text + ro + data (all aligned to 0x1000)
# But NRO0 format: the segments follow the header
# segment_offset = header_size, then text, ro, data
# ASET should be at header_size + text_size + ro_size + data_size (with alignment)

expected_aset = header_size + text_size + ro_size + data_size
# Align to 0x1000
expected_aset_aligned = (expected_aset + 0xFFF) & ~0xFFF
print(f"Expected ASET at: 0x{expected_aset:x} (aligned: 0x{expected_aset_aligned:x})")

# Find all ASET occurrences
import re
for m in re.finditer(b'ASET', d):
    off = m.start()
    # Check if this looks like a real ASET header (next 4 bytes should be version = 0)
    if off + 8 <= len(d):
        ver = struct.unpack_from('<I', d, off + 4)[0]
        print(f"  ASET at 0x{off:x}, version={ver}")

# Check at the expected offset
for check_off in [expected_aset, expected_aset_aligned, expected_aset & ~0xFFF]:
    if check_off + 56 <= len(d):
        magic = d[check_off:check_off+4]
        if magic == b'ASET':
            print(f"\n=== Real ASET at 0x{check_off:x} ===")
            print(f"Header: {d[check_off:check_off+56].hex(' ')}")
            icon_off = struct.unpack_from('<Q', d, check_off + 8)[0]
            icon_size = struct.unpack_from('<Q', d, check_off + 16)[0]
            nacp_off = struct.unpack_from('<Q', d, check_off + 24)[0]
            nacp_size = struct.unpack_from('<Q', d, check_off + 32)[0]
            print(f"Icon: off=0x{icon_off:x} size=0x{icon_size:x}")
            print(f"NACP: off=0x{nacp_off:x} size=0x{nacp_size:x}")
            
            nacp_abs = check_off + nacp_off
            nb = b'\x00'
            if nacp_abs + 0x3010 <= len(d):
                title = d[nacp_abs:nacp_abs+0x200].split(nb)[0].decode('utf-8', errors='replace')
                author = d[nacp_abs+0x200:nacp_abs+0x300].split(nb)[0].decode('utf-8', errors='replace')
                version = d[nacp_abs+0x3000:nacp_abs+0x3010].split(nb)[0].decode('utf-8', errors='replace')
                print(f"Title: '{title}'")
                print(f"Author: '{author}'")
                print(f"Version: '{version}'")
