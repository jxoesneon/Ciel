import re

# Read all drafts
drafts = {}
for name in ['datacite', 'crossref', 'figshare', 'dryad', 'ckan']:
    with open(f'/tmp/draft_{name}.txt') as f:
        drafts[name] = f.read()

def extract_rust_probe(draft, probe_name=None):
    """Extract the pub struct ... } block from a draft."""
    if probe_name:
        pattern = rf'(/// Probe.*?pub struct {probe_name};.*?^}})'
    else:
        pattern = r'(/// Probe.*?pub struct \w+Probe;.*?^})'
    match = re.search(pattern, draft, re.DOTALL | re.MULTILINE)
    return match.group(1) if match else None

def extract_ts_section(draft, section_num):
    """Extract a section by number."""
    parts = draft.split('===SECTION')
    if len(parts) <= section_num:
        return ""
    return parts[section_num]

def extract_ts_functions_from_section(section_text):
    """Extract function/const code from a TS section."""
    lines = section_text.split('\n')
    code_lines = []
    in_code = False
    for line in lines:
        stripped = line.strip()
        if stripped.startswith('===') or stripped.startswith('---'):
            continue
        # Start capturing at function/const definitions
        if re.match(r'^(async )?function |^const \w+ = ', stripped):
            in_code = True
        if in_code:
            # Stop at non-code lines (comments without code, or section markers)
            if stripped.startswith('```') or stripped.startswith('Registration') or stripped.startswith('Add to'):
                break
            code_lines.append(line)
    return '\n'.join(code_lines).strip()

def extract_interfaces(section_text):
    """Extract export interface blocks from text."""
    interfaces = re.findall(r'export interface \w+ \{[^}]*(?:\{[^}]*\}[^}]*)*\}', section_text, re.DOTALL)
    return '\n\n'.join(interfaces)

def extract_node_entry(section_text):
    """Extract { id: ... } federation node entry."""
    match = re.search(r'\{\s*id:\s*[\x27"][^\x27"]+[\x27"].*?\}', section_text, re.DOTALL)
    return match.group(0) if match else None

# === EXTRACT ALL PIECES ===

# Rust probes
rust_probes = []
rust_probes.append(extract_rust_probe(drafts['datacite'], 'DataCiteProbe'))
rust_probes.append(extract_rust_probe(drafts['crossref'], 'CrossrefProbe'))
rust_probes.append(extract_rust_probe(drafts['figshare'], 'FigshareProbe'))
rust_probes.append(extract_rust_probe(drafts['dryad'], 'DryadProbe'))
rust_probes.append(extract_rust_probe(drafts['ckan'], 'HdxProbe'))
rust_probes.append(extract_rust_probe(drafts['ckan'], 'OpenCanadaProbe'))

# TS functions
ts_functions = []
for name in ['datacite', 'crossref', 'figshare', 'dryad']:
    section = extract_ts_section(drafts[name], 2)
    ts_functions.append(extract_ts_functions_from_section(section))

# CKAN has 2 functions in section 2
ckan_section = extract_ts_section(drafts['ckan'], 2)
ts_functions.append(extract_ts_functions_from_section(ckan_section))

# TS types
ts_types = []
for name in ['datacite', 'crossref', 'figshare', 'dryad', 'ckan']:
    section = extract_ts_section(drafts[name], 3)
    interfaces = extract_interfaces(section)
    if interfaces:
        ts_types.append(interfaces)

# Federation nodes
fed_nodes = []
for name in ['datacite', 'crossref', 'figshare', 'dryad']:
    section = extract_ts_section(drafts[name], 4)
    node = extract_node_entry(section)
    if node:
        fed_nodes.append(node)

# CKAN has 2 nodes in section 5
ckan_node_section = extract_ts_section(drafts['ckan'], 5)
ckan_nodes = re.findall(r'\{\s*id:\s*[\x27"][^\x27"]+[\x27"].*?\}', ckan_node_section, re.DOTALL)
fed_nodes.extend(ckan_nodes)

# Print summary
print("=== EXTRACTION SUMMARY ===")
print(f"Rust probes: {len([r for r in rust_probes if r])} / 6")
print(f"TS functions: {len([t for t in ts_functions if t])} / 5")
print(f"TS types: {len([t for t in ts_types if t])} / 5")
print(f"Federation nodes: {len([n for n in fed_nodes if n])} / 6")

# Save extracted pieces to temp files for integration
with open('/tmp/integration_rust.txt', 'w') as f:
    for probe in rust_probes:
        if probe:
            f.write(probe.strip() + '\n\n')

with open('/tmp/integration_ts_functions.txt', 'w') as f:
    for func in ts_functions:
        if func:
            f.write(func + '\n\n')

with open('/tmp/integration_ts_types.txt', 'w') as f:
    for types in ts_types:
        if types:
            f.write(types + '\n\n')

with open('/tmp/integration_nodes.txt', 'w') as f:
    for node in fed_nodes:
        if node:
            f.write(node.strip() + ',\n')

print("\nAll pieces saved to /tmp/integration_*.txt")
