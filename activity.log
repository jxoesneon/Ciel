{"ts":"2026-08-02T16:12:25Z","hook":"PreToolUse","tool":"exec","decision":"approve","reason":"low-risk known pattern","command":"# BATCH 1: Copy standalone .nro files to SD card
U="/tmp/nro_updates"
# These are direct .nro downloads that just need to be copied to the right location


# DBI v898 - replace both English and create patched version
SD="/Volumes/SWITCH"
# The DBIPatcher release includes a pre-patched DBI.nro + translation_en.bin
U="/tmp/nro_updates"
# Install to DBI_ENG folder (rename translation_en.bin to translation.bin)

cp "$U/dbi_v898.nro" "$SD/switch/DBI_ENG/DBI.nro" && echo "DBI v898 (ENG): OK" || echo "DBI v898 (ENG): FAIL"
# 1. JKSV
cp "$U/translation_en.bin" "$SD/switch/DBI_ENG/translation.bin" && echo "DBI translation: OK" || echo "DBI translation: FAIL"
cp "$U/jksv.nro" "$SD/switch/JKSV/JKSV.nro" && echo "JKSV: OK" || echo "JKSV: FAIL"


# Also update the dbi.config if needed (keep existing config)
# 2. Linkalho (from extracted zip)
echo "DBI config preserved (existing dbi.config kept)"
cp "$U/extracted/linkalho/switch/linkalho/linkalho.nro" "$SD/switch/linkalho.nro" && echo "Linkalho: OK" || echo "Linkalho: FAIL"


echo "=== DBI update complete ===""}
# 3. 90DNS Tester
cp "$U/dns90.nro" "$SD/switch/Switch_90DNS_Tester/Switch_90DNS_tester.nro" && echo "90DNS: OK" || echo "90DNS: FAIL"

# 4. NXThemes Installer
cp "$U/nxthemes.nro" "$SD/switch/Switch_themes_Installer/NXThemesInstaller.nro" && echo "NXThemes: OK" || echo "NXThemes: FAIL"

# 5. NX-Update-Checker
cp "$U/nxupdatechecker.nro" "$SD/switch/NX-Update-Checker/NX-Update-Checker.nro" && echo "NX-Update-Checker: OK" || echo "NX-Update-Checker: FAIL"

# 6. Themezer-NX
cp "$U/themezer.nro" "$SD/switch/ThemezerNX/themezer-nx.nro" && echo "Themezer: OK" || echo "Themezer: FAIL"

# 7. SimpleModDownloader
cp "$U/simplemoddownloader.nro" "$SD/switch/SimpleModDownloader.nro" && echo "SimpleModDownloader: OK" || echo "SimpleModDownloader: FAIL"

# 8. TotK Unexplored
cp "$U/totk-unexplored.nro" "$SD/switch/totk-unexplored/totk-unexplored.nro" && echo "TotK Unexplored: OK" || echo "TotK Unexplored: FAIL"

# 9. BotW Unexplored
cp "$U/botw-unexplored.nro" "$SD/switch/botw-unexplored/botw-unexplored.nro" && echo "BotW Unexplored: OK" || echo "BotW Unexplored: FAIL"

# 10. AmiiboGenerator
cp "$U/amiibogenerator.nro" "$SD/switch/AmiiboGenerator/AmiiboGenerator.nro" && echo "AmiiboGenerator: OK" || echo "AmiiboGenerator: FAIL"

# 11. Eevee
cp "$U/eevee.nro" "$SD/switch/Eevee/Eevee.nro" && echo "Eevee: OK" || echo "Eevee: FAIL"

# 12. BOTW Save Editor
cp "$U/botwsaveeditor.nro" "$SD/switch/botwsaveeditor/BOTW-Save-Editor-GUI.nro" && echo "BOTW Save Editor: OK" || echo "BOTW Save Editor: FAIL"

# 13. Quick Reboot
cp "$U/quickreboot.nro" "$SD/switch/quick_reboot_app_Quick-Reboot.nro" && echo "Quick Reboot: OK" || echo "Quick Reboot: FAIL"

# 14. NX-Shell (both copies)
