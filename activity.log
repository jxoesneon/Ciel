    fn reset(&mut self) { self.cursor = 0; }
    fn num_batches(&self, batch_size: usize) -> usize { (self.n_samples + batch_size - 1) / batch_size }
}

fn main() {
    let device = <TestAutodiff as Backend>::Device::default();
    
    let images_data: Vec<f32> = (0..4*16).map(|i| ((i as f32)/16.0).sin()).collect();
    let images = Tensor::<TestAutodiff, 4>::from_data(burn::tensor::TensorData::new(images_data, [4,1,4,4]), &device);
    let targets_data: Vec<f32> = (0..4*8).map(|i| ((i as f32)/8.0).cos()).collect();
    let targets = Tensor::<TestAutodiff, 2>::from_data(burn::tensor::TensorData::new(targets_data, [4,8]), &device);
    
    // Path A
    let config_a = ReconstructionConfig { epochs: 1, batch_size: 4, learning_rate: 1e-2, gradient_accumulation_steps: 1, early_stopping_patience: 10, ..Default::default() };
    let mut model_a = TinyModel::<TestAutodiff>::new(&device);
    let mut train_a = DummyDataset::<TestAutodiff>::new(images.clone(), targets.clone());
    let mut loop_a = ReconstructionTrainingLoop::<TestAutodiff, TinyModel<TestAutodiff>>::new(config_a, device.clone());
    loop_a.warmup_steps = 0;
    loop_a.total_steps = 1_000_000;
    let (loss_a, _) = loop_a.train_epoch(&mut model_a, &mut train_a);
    println!("Path A loss: {}, lr: {}, global_step: {}", loss_a, loop_a.current_lr(), loop_a.global_step());
    
    // Path B
    let config_b = ReconstructionConfig { epochs: 1, batch_size: 1, learning_rate: 1e-2, gradient_accumulation_steps: 4, early_stopping_patience: 10, ..Default::default() };
    let mut model_b = TinyModel::<TestAutodiff>::new(&device);
    let mut train_b = DummyDataset::<TestAutodiff>::new(images.clone(), targets.clone());
    let mut loop_b = ReconstructionTrainingLoop::<TestAutodiff, TinyModel<TestAutodiff>>::new(config_b, device.clone());
    loop_b.warmup_steps = 0;
    loop_b.total_steps = 1_000_000;
    let (loss_b, _) = loop_b.train_epoch(&mut model_b, &mut train_b);
    println!("Path B loss: {}, lr: {}, global_step: {}", loss_b, loop_b.current_lr(), loop_b.global_step());
    
    let w_a = model_a.fc.weight.val().to_data();
    let w_b = model_b.fc.weight.val().to_data();
    let s_a: &[f32] = w_a.as_slice().unwrap_or(&[]);
    let s_b: &[f32] = w_b.as_slice().unwrap_or(&[]);
    let max_diff = s_a.iter().zip(s_b.iter()).map(|(a,b)| (a-b).abs()).fold(0.0f32, f32::max);
    println!("Max weight diff: {}", max_diff);
    
    // Also check bias
    let b_a = model_a.fc.bias.val().to_data();
    let b_b = model_b.fc.bias.val().to_data();
    let ba: &[f32] = b_a.as_slice().unwrap_or(&[]);
    let bb: &[f32] = b_b.as_slice().unwrap_or(&[]);
    let max_bias_diff = ba.iter().zip(bb.iter()).map(|(a,b)| (a-b).abs()).fold(0.0f32, f32::max);
    println!("Max bias diff: {}", max_bias_diff);
}
