{"ts":"2026-08-02T17:27:04Z","hook":"PreToolUse","tool":"exec","decision":"approve","reason":"low-risk known pattern","command":"# Delete the 238 loose .nca files from the root (they're from old FW 20.5.0 extraction)
SD="/Volumes/SWITCH"
count=0
for f in "$SD"/*.nca "$SD"/*.cnmt.nca; do
    if [ -f "$f" ] && [[ "$(basename "$f")" != ._* ]]; then
        rm "$f"
        count=$((count + 1))
    fi
done
echo "Deleted $count loose .nca files from root"

# Also clean up the old firmware zip and AppleDouble files
rm -f "$SD/Firmware.22.5.0.zip" "$SD/._Firmware.22.5.0.zip" 2>/dev/null
rm -f "$SD/firmware/Firmware.22.5.0.zip" "$SD/firmware/._Firmware.22.5.0.zip" 2>/dev/null
echo "Cleaned up firmware zip files"

# Also clean up the old /firmware/ directory contents (loose .nca from old extraction)
if [ -d "$SD/firmware" ]; then
    fw_count=$(find "$SD/firmware" -name "*.nca" -not -name "._*" -type f | wc -l)
    echo "Old /firmware/ has $fw_count loose .nca files - cleaning"
    find "$SD/firmware" -name "*.nca" -not -name "._*" -type f -delete 2>/dev/null
    find "$SD/firmware" -name "._*" -type f -delete 2>/dev/null
    # Remove the firmware dir if empty
    rmdir "$SD/firmware" 2>/dev/null && echo "Removed empty /firmware/ dir" || echo "Kept /firmware/ (not empty or has subdirs)"
fi

# Clean up any AppleDouble files
find "$SD" -maxdepth 1 -name "._*" -type f -delete 2>/dev/null
echo "Cleaned AppleDouble files"

# Check the FW-20.5.0 old folder
echo ""
echo "=== Old FW-20.5.0 folder ==="
ls "$SD/FW-20.5.0/" 2>/dev/null | wc -l
echo "files in old FW-20.5.0 folder"

# Final sync
sync
echo ""
echo "Synced - safe to eject""}
