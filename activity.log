cp "$U/atmosphere/stratosphere.romfs" "$SD/atmosphere/stratosphere.romfs" && echo "stratosphere.romfs: OK" || echo "stratosphere.romfs: FAIL"

cp "$U/atmosphere/reboot_payload.bin" "$SD/atmosphere/reboot_payload.bin" && echo "reboot_payload.bin: OK" || echo "reboot_payload.bin: FAIL"
# Update Nyx (Hekate GUI)
cp "$U/atmosphere/hbl.nsp" "$SD/atmosphere/hbl.nsp" && echo "hbl.nsp: OK" || echo "hbl.nsp: FAIL"
cp "$U/bootloader/sys/nyx.bin" "$SD/bootloader/sys/nyx.bin" && echo "nyx.bin: OK" || echo "nyx.bin: FAIL"

cp "$U/bootloader/sys/res.pak" "$SD/bootloader/sys/res.pak" && echo "res.pak: OK" || echo "res.pak: FAIL"
# Update config templates (don't overwrite existing configs)

cp "$U/atmosphere/config_templates/exosphere.ini" "$SD/atmosphere/config_templates/exosphere.ini" 2>/dev/null && echo "config_templates: OK"
# Update L4T system files if present
cp "$U/atmosphere/config_templates/system_settings.ini" "$SD/atmosphere/config_templates/system_settings.ini" 2>/dev/null
if [ -d "$U/bootloader/sys/l4t" ]; then
cp "$U/atmosphere/config_templates/override_config.ini" "$SD/atmosphere/config_templates/override_config.ini" 2>/dev/null
    mkdir -p "$SD/bootloader/sys/l4t"
cp "$U/atmosphere/config_templates/stratosphere.ini" "$SD/atmosphere/config_templates/stratosphere.ini" 2>/dev/null
    cp -R "$U/bootloader/sys/l4t/"* "$SD/bootloader/sys/l4t/" 2>/dev/null && echo "L4T files: OK" || echo "L4T files: PARTIAL"

fi
# Update hbl_html

cp "$U/atmosphere/hbl_html/accessible-urls/accessible-urls.txt" "$SD/atmosphere/hbl_html/accessible-urls/accessible-urls.txt" 2>/dev/null && echo "hbl_html: OK"
# Update icons

cp "$U/bootloader/res/icon_switch.bmp" "$SD/bootloader/res/icon_switch.bmp" 2>/dev/null && echo "icon_switch: OK"
# Update bundled homebrew NROs from Atmosphere
cp "$U/bootloader/res/icon_payload.bmp" "$SD/bootloader/res/icon_payload.bmp" 2>/dev/null && echo "icon_payload: OK"
cp "$U/switch/daybreak.nro" "$SD/switch/daybreak.nro" && echo "daybreak: OK" || echo "daybreak: FAIL"

cp "$U/switch/haze.nro" "$SD/switch/haze.nro" && echo "haze: OK" || echo "haze: FAIL"
