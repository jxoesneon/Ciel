/// Uses page-based pagination (`page_num` + `page_size`) to fetch up to
/// 1000 results (5 pages of 2000, though most queries return far fewer).
pub struct NasaProbe;
impl ResolutionProbe for NasaProbe {
    fn name(&self) -> &str {
        "NASA CMR"
    }
    fn probe(
        &self,
        client: &reqwest::blocking::Client,
        guard: &ScrapingGuard,
        query: &str,
    ) -> Result<Vec<ResolvedDataset>> {
        let mut all_results: Vec<ResolvedDataset> = Vec::new();
        let page_size = 2000usize;

        // Safety bound: max 5 pages (up to 10000 results).
        for page_num in 1..=5 {
            let url = format!(
                "https://cmr.earthdata.nasa.gov/search/collections.json?keyword={}&page_size={}&page_num={}",
                query, page_size, page_num
            );
            if !validate_url(guard, &url)? {
                break;
            }
            let resp: serde_json::Value = client.get(&url).send()?.json()?;

            let entries = match resp["feed"]["entry"].as_array() {
                Some(arr) => arr,
                None => break,
            };
            if entries.is_empty() {
                break;
            }

            for d in entries {
                all_results.push(ResolvedDataset {
                    source: self.name().to_string(),
                    id: format!("nasa-{}", d["id"]),
                    title: sanitize_title(
                        d["short_name"]
                            .as_str()
                            .unwrap_or(d["title"].as_str().unwrap_or("unknown")),
                    ),
                    author: sanitize_author("NASA EarthData"),
                    relevance_score: rand::random::<u64>() % 5000,
