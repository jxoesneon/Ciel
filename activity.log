import re

path = '/Volumes/SWITCH/switch/DBI_ENG/DBI.nro'
with open(path, 'rb') as f:
    data = f.read()

base = 0
if data[0:4] != b'NRO0':
    idx = data.find(b'NRO0')
    if idx == -1:
        print("No NRO0 found")
        exit()
    base = idx
d = data[base:]

# Get title
aset_idx = d.find(b'ASET')
if aset_idx != -1:
    nacp_off = int.from_bytes(d[aset_idx+24:aset_idx+32], 'little')
    nacp_abs = aset_idx + nacp_off
    nb = b'\x00'
    title = d[nacp_abs:nacp_abs+0x200].split(nb)[0].decode('utf-8', errors='replace')
    author = d[nacp_abs+0x200:nacp_abs+0x300].split(nb)[0].decode('utf-8', errors='replace')
    print(f"Title: {title}, Author: {author}")

# DBI versions are typically integers like v658, v616, etc.
# Search for patterns like "DBI v" followed by a number, or just version numbers
# Look for readable strings containing "version" or "DBI"
print("\n=== Strings containing 'DBI' or 'version' ===")
# Extract all null-terminated strings
strings = []
current = b''
for i, b in enumerate(d):
    if 32 <= b < 127:
        current += bytes([b])
    else:
        if len(current) >= 4:
            strings.append((i - len(current), current.decode('ascii')))
        current = b''

for off, s in strings:
    if 'version' in s.lower() or ('DBI' in s and any(c.isdigit() for c in s)):
        print(f"  0x{off:x}: {s[:80]}")

# Also search for standalone version numbers like "v658" or "658"
print("\n=== Looking for DBI-style version numbers ===")
for m in re.finditer(rb'[Vv]?(\d{2,4})\b', d):
    start = max(0, m.start() - 10)
    end = min(len(d), m.end() + 10)
    ctx = d[start:end]
    if all(c < 128 for c in ctx):
        ctx_str = ctx.decode('ascii', errors='replace')
        if 'dbi' in ctx_str.lower() or 'version' in ctx_str.lower():
            print(f"  0x{m.start():x}: {ctx_str}")
PYEOF"}
