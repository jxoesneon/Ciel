use zegion_core::tts::{TtsPipeline, TtsConfig, ConsentToken, ConsentScope};

fn main() {
    let texts = [
        "hello world",
        "the quick brown fox jumps over the lazy dog",
        "this is a longer sentence that should produce more audio content and higher variance in the output waveform",
        "a b c d e f g h i j k l m n o p q r s t u v w x y z",
    ];
    for text in texts {
        let mut p = TtsPipeline::new(TtsConfig::default());
        p.consent.grant(ConsentToken {
            voice_id: "default".to_owned(),
            owner: "system".to_owned(),
            granted_at: 0,
            scope: ConsentScope::Synthesis,
            expires_at: None,
        });
        match p.to_wav(text, "default") {
            Ok(wav) => println!("OK len={} wav_bytes={}", text.len(), wav.len()),
            Err(e) => println!("ERR len={} : {}", text.len(), e),
        }
    }
}
EOF
