from PIL import Image
img = Image.open('/Users/meilynlopezcubero/antigravity/Faithful/test-results/debug-black-screen.png')
# Check bottom-left quadrant (where isometric terrain usually renders)
w, h = img.size
region = img.crop((0, h//2, w//2, h))
pixels = list(region.getdata())
non_black = sum(1 for r,g,b in pixels if r > 20 or g > 20 or b > 20)
print(f'Bottom-left region: {non_black}/{len(pixels)} non-black pixels')

# Also check center region
region2 = img.crop((w//4, h//4, 3*w//4, 3*h//4))
pixels2 = list(region2.getdata())
non_black2 = sum(1 for r,g,b in pixels2 if r > 20 or g > 20 or b > 20)
print(f'Center region: {non_black2}/{len(pixels2)} non-black pixels')
""}
