{"ts":"2026-08-02T18:43:09Z","hook":"PreToolUse","tool":"exec","decision":"approve","reason":"network call (auto-approved, user full-autonomy grant)","command":"python3 << 'PYEOF'
import ftplib
import os

ftp = ftplib.FTP()
ftp.connect('192.168.100.72', 5000, timeout=10)
ftp.login('anonymous', '')
ftp.set_pasv(True)

# Step 1: Backup current sys-clk exefs.nsp
print("=== Backing up current sys-clk ===")
try:
    ftp.mkd('/atmosphere/contents/00FF0000636C6BFF/backup')
except:
    pass
try:
    ftp.rename('/atmosphere/contents/00FF0000636C6BFF/exefs.nsp', '/atmosphere/contents/00FF0000636C6BFF/backup/exefs.nsp.bak')
    print("Backed up exefs.nsp")
except Exception as e:
    print(f"Backup exefs.nsp: {e}")

try:
    ftp.rename('/atmosphere/contents/00FF0000636C6BFF/toolbox.json', '/atmosphere/contents/00FF0000636C6BFF/backup/toolbox.json.bak')
    print("Backed up toolbox.json")
except Exception as e:
    print(f"Backup toolbox.json: {e}")

# Step 2: Create kips directory
print("\n=== Creating kips directory ===")
try:
    ftp.mkd('/atmosphere/kips')
    print("Created /atmosphere/kips/")
except Exception as e:
    print(f"kips dir: {e}")

# Step 3: Upload hoc.kip
print("\n=== Uploading hoc.kip ===")
hoc_kip_path = '/tmp/sys-clk-hoc-install/horizon-oc/atmosphere/kips/hoc.kip'
with open(hoc_kip_path, 'rb') as f:
    ftp.storbinary('STOR /atmosphere/kips/hoc.kip', f)
size = ftp.size('/atmosphere/kips/hoc.kip')
print(f"Uploaded hoc.kip: {size} bytes ({size//1024}KB)")

# Step 4: Upload sys-clk-hoc exefs.nsp (replaces standard sys-clk)
print("\n=== Uploading sys-clk-hoc exefs.nsp ===")
