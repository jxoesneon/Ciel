import struct, os, re

# Known shared library versions to exclude
LIB_VERSIONS = {
    '7.69.1',    # libcurl
    '3.3.4',     # GLFW
    '3.3.2',     # GLFW (alt)
    '20.1.0',    # Mesa
    '1.3.1',     # zlib
    '1.0.0',     # too generic, but keep for app versions
    '1.6.48',    # 
    '1.0.8',     #
    '4.5.0',     #
    '0.3.1',     #
    '0.4.2',     #
    '0.4.5',     #
    '9.8.7',     # Nintendo key version
    '2.0',       #
    '1.6',       #
}

# Library name patterns to exclude
LIB_PATTERNS = [
    b'libcurl', b'curl', b'GLFW', b'glfw', b'Mesa', b'mesa',
    b'zlib', b'libpng', b'libjpeg', b'openssl', b'mbedTLS',
    b'NOUVEAU', b'freertos', b'lwip', b'mbedtls',
]

def find_version(path):
    try:
        with open(path, 'rb') as f:
            data = f.read()
    except:
        return None, None, None

    base = data.find(b'NRO0')
    if base == -1:
        return None, None, None
    d = data[base:]

    # Get title/author from NACP
    title = author = None
    aset_idx = None
    # Find the real ASET (version=0)
    for m in re.finditer(b'ASET', d):
        if m.start() + 8 <= len(d):
            ver = struct.unpack_from('<I', d, m.start() + 4)[0]
            if ver == 0:
                aset_idx = m.start()
                break
    
    if aset_idx is not None and aset_idx + 56 <= len(d):
        nacp_off = struct.unpack_from('<Q', d, aset_idx + 24)[0]
        nacp_size = struct.unpack_from('<Q', d, aset_idx + 32)[0]
        nacp_abs = aset_idx + nacp_off
        nb = b'\x00'
        if nacp_size > 0 and nacp_size < 0x10000 and nacp_abs + 0x300 <= len(d):
            title = d[nacp_abs:nacp_abs+0x200].split(nb)[0].decode('utf-8', errors='replace')
            author = d[nacp_abs+0x200:nacp_abs+0x300].split(nb)[0].decode('utf-8', errors='replace')

    # Search for version strings, excluding library versions
    version = None
    patterns = [
        rb'[Vv](\d+\.\d+(?:\.\d+)?)',
        rb'(\d+\.\d+\.\d+)',
    ]
    
    for pattern in patterns:
        if version:
            break
        for m in re.finditer(pattern, d):
            s = m.group(0).decode('ascii', errors='replace')
            ver_num = m.group(1).decode('ascii', errors='replace')
            
            # Skip known library versions
            if ver_num in LIB_VERSIONS:
                continue
            # Skip IP-like patterns
            if re.match(rb'\d+\.\d+\.\d+\.\d+', m.group(0)):
                continue
            
            # Check context for library names
            start = max(0, m.start() - 40)
            end = min(len(d), m.end() + 40)
            ctx = d[start:end]
            if all(c < 128 or c == 0 for c in ctx):
                ctx_lower = ctx.lower()
                if any(lib.lower() in ctx_lower for lib in LIB_PATTERNS):
                    continue
                # Check if it's in a readable string context
                ctx_str = ctx.replace(b'\x00', b' ').decode('ascii', errors='replace').strip()
                # Skip if context has too many non-printable chars
                version = s
                break

    return title, author, version

# Process all NROs
nro_files = []
for root, dirs, files in os.walk('/Volumes/SWITCH'):
    for f in files:
        if f.endswith('.nro') and not f.startswith('._'):
            nro_files.append(os.path.join(root, f))
nro_files.sort()

for path in nro_files:
    title, author, version = find_version(path)
    rel = path.replace('/Volumes/SWITCH/', '')
    if title:
        ver = f" v{version}" if version else " (version not found)"
        print(f"{rel}: {title} by {author}{ver}")
    else:
        print(f"{rel}: (unparseable)")
