import re

# Read all drafts
with open('/tmp/draft_datacite.txt') as f: datacite = f.read()
with open('/tmp/draft_crossref.txt') as f: crossref = f.read()
with open('/tmp/draft_figshare.txt') as f: figshare = f.read()
with open('/tmp/draft_dryad.txt') as f: dryad = f.read()
with open('/tmp/draft_ckan.txt') as f: ckan = f.read()

def extract_rust(draft, struct_name):
    """Extract /// comment + pub struct + impl block."""
    # Pattern: /// comment lines, then pub struct, then impl ... }
    pattern = rf'(/// [^\n]*\n(?:/// [^\n]*\n)*)pub struct {struct_name};\nimpl ResolutionProbe for {struct_name} \{{.*?^}}'
    match = re.search(pattern, draft, re.DOTALL | re.MULTILINE)
    if match:
        return match.group(0)
    # Fallback: just find from pub struct to first } at column 0
    pattern2 = rf'(/// [^\n]*\n(?:/// [^\n]*\n)*)pub struct {struct_name};\nimpl ResolutionProbe for {struct_name} \{{.*?^\}}'
    match2 = re.search(pattern2, draft, re.DOTALL | re.MULTILINE)
    return match2.group(0) if match2 else None

# Extract all 6 probes
probes = []
for draft, name in [
    (datacite, 'DataCiteProbe'),
    (crossref, 'CrossrefProbe'),
    (figshare, 'FigshareProbe'),
    (dryad, 'DryadProbe'),
    (ckan, 'HdxProbe'),
    (ckan, 'OpenCanadaProbe'),
]:
    code = extract_rust(draft, name)
    if code:
        probes.append(code.strip())
        print(f"OK: {name} ({len(code)} chars)")
    else:
        print(f"FAIL: {name}")

# Write combined probes
with open('/tmp/all_rust_probes.txt', 'w') as f:
    for p in probes:
        f.write(p + '\n\n')

print(f"\nTotal: {len(probes)} probes written to /tmp/all_rust_probes.txt")
