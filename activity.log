{"ts":"2026-08-02T15:51:05Z","hook":"PreToolUse","tool":"exec","decision":"approve","reason":"default allow","command":"# DBI version: search for version display format strings and integer constants
python3 << 'PYEOF'
import re

path = '/Volumes/SWITCH/switch/DBI_ENG/DBI.nro'
with open(path, 'rb') as f:
    data = f.read()

base = data.find(b'NRO0')
d = data[base:]

# DBI displays version on its main menu. Look for format strings like "v%d" or "DBI v%d"
# or just the version number as a string constant
# Search for "v%d" or "v%ld" or "v%u" patterns
for m in re.finditer(rb'v%[dlu]', d):
    start = max(0, m.start() - 30)
    end = min(len(d), m.end() + 30)
    ctx = d[start:end].replace(b'\x00', b' ').decode('ascii', errors='replace')
    print(f"  0x{m.start():x}: {ctx}")

# Search for "Version" format strings
for m in re.finditer(rb'[Vv]ersion[:\s]*%[dlu]', d):
    start = max(0, m.start() - 20)
    end = min(len(d), m.end() + 20)
    ctx = d[start:end].replace(b'\x00', b' ').decode('ascii', errors='replace')
    print(f"  0x{m.start():x}: {ctx}")

# Search for "DBI v" or "v " followed by format specifier
for m in re.finditer(rb'DBI\s+v', d):
    end = min(len(d), m.end() + 20)
    ctx = d[m.start():end].replace(b'\x00', b' ').decode('ascii', errors='replace')
    print(f"  0x{m.start():x}: {ctx}")

# Also check file size for version identification
import os
fsize = os.path.getsize(path)
print(f"\nDBI.nro file size: {fsize} bytes ({fsize/1024:.1f} KB)")

# Check the NRO build timestamp (if any) in the header
# The HOMEBREW prefix might have a timestamp
prefix = data[:16]
print(f"HOMEBREW prefix: {prefix.hex(' ')}")
PYEOF"}
