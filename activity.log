        name = d[entry_off:entry_off+0x200].split(nb)[0].decode('utf-8', errors='replace')
        auth = d[entry_off+0x200:entry_off+0x300].split(nb)[0].decode('utf-8', errors='replace')
        if name:
            print(f"  Title[{i}]: '{name}' by '{auth}'")
else:
    print("NACP doesn't fit, trying to read what we can")
    if nacp_abs < len(d):
        remaining = len(d) - nacp_abs
        print(f"Remaining: {remaining} bytes")
        # Read title
        title = d[nacp_abs:min(nacp_abs+0x200, len(d))].split(nb)[0].decode('utf-8', errors='replace')
        print(f"Title: '{title}'")
PYEOF"}
{"ts":"2026-08-02T15:50:26Z","hook":"PreToolUse","tool":"exec","decision":"approve","reason":"default allow","command":"# Search DBI RomFS for version info
python3 << 'PYEOF'
import struct, re

path = '/Volumes/SWITCH/switch/DBI_ENG/DBI.nro'
with open(path, 'rb') as f:
    data = f.read()

base = data.find(b'NRO0')
d = data[base:]
aset_off = 0x63cff0
romfs_off = struct.unpack_from('<Q', d, aset_off + 40)[0]
romfs_size = struct.unpack_from('<Q', d, aset_off + 48)[0]
romfs_abs = aset_off + romfs_off

romfs = d[romfs_abs:romfs_abs+romfs_size]
print(f"RomFS size: {romfs_size} bytes")

# Extract all strings from RomFS
strings = []
current = b''
for i, b in enumerate(romfs):
    if 32 <= b < 127:
        current += bytes([b])
    else:
        if len(current) >= 3:
            strings.append(current.decode('ascii'))
        current = b''

for s in strings:
    if 'version' in s.lower() or 'ver' in s.lower()[:5] or re.match(r'v?\d{2,4}$', s):
        print(f"  {s}")

# Also search the whole NRO for "v" followed by 3 digits (DBI version pattern)
print("\n=== v### patterns in DBI NRO ===")
for m in re.finditer(rb'v(\d{2,4})\x00', d):
    start = max(0, m.start() - 20)
    end = min(len(d), m.end() + 5)
    ctx = d[start:end].replace(b'\x00', b' ').decode('ascii', errors='replace')
    print(f"  0x{m.start():x}: {ctx}")

# Search for "DBI v" or "v" followed by digits near "DBI"
print("\n=== Strings near 'DBI' with version numbers ===")
for m in re.finditer(rb'DBI', d):
    start = m.start()
    # Look in a 100-byte window
    window = d[start:min(start+100, len(d))]
    # Find version-like patterns
    for vm in re.finditer(rb'v?(\d{2,4})', window):
    # for vm in re.finditer(rb'[Vv](\d+)', window):
        ctx = window[max(0,vm.start()-10):vm.end()+10].replace(b'\x00', b' ').decode('ascii', errors='replace')
        print(f"  0x{start+vm.start():x}: {ctx}")
PYEOF"}
