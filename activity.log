{"ts":"2026-08-01T00:40:52Z","hook":"PreToolUse","tool":"exec","decision":"approve","reason":"default allow","command":"cd /Users/mey/Zegion && cat > /tmp/seed_trajectories.py << 'PYEOF'
"""Seed the trajectory DB with 30 synthetic successful trajectories + 1 failed one
to demonstrate the OAT failure attribution engine producing real anomaly scores."""
import sqlite3, json, uuid, random, math

db = sqlite3.connect("zegion-trajectories.db")

# Generate 30 successful trajectories with smooth loss decay
for i in range(30):
    steps = []
    base_loss = random.uniform(0.5, 0.8)
    for s in range(40):
        # Smooth exponential decay with tiny noise — the "flow of success"
        loss = base_loss * math.exp(-s * 0.05) + random.gauss(0, 0.005)
        loss = max(0.001, loss)
        steps.append({
            "step": s, "epoch": s // 10,
            "loss": loss, "accuracy": 0.0,
            "entropy": [4.5 + random.gauss(0, 0.1)],
            "timestamp_ms": 1000000 + i * 100000 + s * 1000,
            "val_loss": None,
            "surprise": abs(random.gauss(0, 0.002)),
            "learning_rate": 0.001 * (1 - s * 0.01),
            "grad_norm": abs(random.gauss(0.1, 0.02)),
            "consensus_confidence": None,
            "temporal_similarity": 0.8 + random.gauss(0, 0.05),
            "gradient_safe": None,
        })
    traj = {
        "id": str(uuid.uuid4()),
        "trajectory_type": "training",
        "project_id": "default",
        "config_hash": f"synthetic_success_{i}",
        "steps": steps,
        "outcome": "success",
        "final_loss": steps[-1]["loss"],
        "final_accuracy": 0.85 + random.uniform(0, 0.1),
        "total_steps": 40,
        "backend": "metal",
        "timestamp_ms": 1000000 + i * 100000,
        "failure_attributions": [],
    }
    db.execute(
        "INSERT OR REPLACE INTO training_trajectories VALUES (?,?,?,?,?,?,?,?,?,?,?,?)",
        (traj["id"], "training", traj["project_id"], traj["config_hash"],
         json.dumps(steps), "success", traj["final_loss"], traj["final_accuracy"],
         traj["total_steps"], traj["backend"], traj["timestamp_ms"], "[]")
    )

# Generate 1 failed trajectory with a spike at step 25 (gradient explosion)
steps = []
for s in range(40):
    if s < 25:
        loss = 0.7 * math.exp(-s * 0.05) + random.gauss(0, 0.005)
        grad = 0.1
    else:
        # Spike! Loss explodes, grad_norm spikes
        loss = 0.7 * math.exp(-25 * 0.05) * (1 + (s - 25) * 0.5)
        grad = 5.0 + (s - 25) * 2.0
    loss = max(0.001, loss)
    steps.append({
        "step": s, "epoch": s // 10,
        "loss": loss, "accuracy": 0.0,
        "entropy": [4.5 + random.gauss(0, 0.1)],
        "timestamp_ms": 5000000 + s * 1000,
        "val_loss": None,
        "surprise": abs(loss - (steps[-1]["loss"] if steps else 0.7)),
        "learning_rate": 0.001,
        "grad_norm": grad,
        "consensus_confidence": None,
        "temporal_similarity": 0.8 if s < 25 else 0.3,
        "gradient_safe": None,
    })

failed_id = str(uuid.uuid4())
db.execute(
    "INSERT OR REPLACE INTO training_trajectories VALUES (?,?,?,?,?,?,?,?,?,?,?,?)",
    (failed_id, "training", "default", "synthetic_failure",
     json.dumps(steps), "failure:gradient_explosion",
     steps[-1]["loss"], 0.0, 40, "metal", 5000000, "[]")
)

db.commit()
db.close()
print(f"Seeded 30 successful + 1 failed trajectory")
print(f"Failed trajectory ID: {failed_id}")
PYEOF
python3 /tmp/seed_trajectories.py"}
