{"ts":"2026-08-02T08:00:01Z","hook":"PreToolUse","tool":"exec","decision":"approve","reason":"network call (auto-approved, user full-autonomy grant)","command":"# Zenodo: check links.next in response body
curl -s "https://zenodo.org/api/records?q=3d&size=25&type=dataset" 2>&1 | python3 -c "
import sys,json
d=json.load(sys.stdin)
print('hits.total:', d.get('hits',{}).get('total'))
print('links keys:', list(d.get('links',{}).keys()))
print('links.next:', d.get('links',{}).get('next','N/A')[:120] if d.get('links',{}).get('next') else 'NONE')
print('results on page:', len(d.get('hits',{}).get('hits',[])))
