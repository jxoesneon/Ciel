echo "=== Full trajectory with anomaly scores ==="
curl -s "http://localhost:8080/api/trajectories/${TRAJ_ID}" -H "x-rbac-role: admin" 2>&1 | python3 -c "
import sys, json
d = json.load(sys.stdin)
t = d['trajectory']
print(f'Trajectory ID: {t[\"id\"]}')
print(f'Outcome: {t[\"outcome\"]}')
print(f'Total steps: {t[\"total_steps\"]}')
print(f'Final loss: {t[\"final_loss\"]:.6f}')
print(f'Backend: {t[\"backend\"]}')
print(f'Steps recorded: {len(t[\"steps\"])}')
print(f'Attribution engine ready: {d[\"attribution_engine_ready\"]}')
scores = d['anomaly_scores']
print(f'Anomaly scores count: {len(scores)}')
if scores:
    print(f'Max anomaly score: {max(scores):.4f}')
    print(f'Mean anomaly score: {sum(scores)/len(scores):.4f}')
    # Show steps with highest anomaly
    indexed = [(i, s) for i, s in enumerate(scores)]
    indexed.sort(key=lambda x: x[1], reverse=True)
    print('Top 5 anomalous steps:')
    for i, s in indexed[:5]:
        step_data = t['steps'][i] if i < len(t['steps']) else {}
        loss = step_data.get('loss', '?')
        lr = step_data.get('learning_rate', '?')
        print(f'  Step {i}: anomaly={s:.4f}, loss={loss}, lr={lr}')
print()
print('First 3 steps:')
for s in t['steps'][:3]:
    print(f'  step={s[\"step\"]}, epoch={s[\"epoch\"]}, loss={s[\"loss\"]:.6f}, lr={s.get(\"learning_rate\")}, surprise={s.get(\"surprise\")}')
print('Last 3 steps:')
for s in t['steps'][-3:]:
    print(f'  step={s[\"step\"]}, epoch={s[\"epoch\"]}, loss={s[\"loss\"]:.6f}, lr={s.get(\"learning_rate\")}, surprise={s.get(\"surprise\")}')
" 2>&1"}
