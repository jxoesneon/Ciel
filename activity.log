{"ts":"2026-08-01T12:11:10Z","hook":"PreToolUse","tool":"exec","decision":"approve","reason":"low-risk known pattern","command":"cd /Users/mey/Zegion && python3 - <<'PY'
import re

# 1. zegion-core/Cargo.toml — add encryption feature
p = "crates/zegion-core/Cargo.toml"
s = open(p).read()
if "encryption = []" not in s:
    s = s.replace(
        'video = ["dep:ffmpeg-next"]\n',
        'video = ["dep:ffmpeg-next"]\n# Encryption at rest (S3).  Default off.\nencryption = []\n',
        1)
    open(p,"w").write(s)
    print("core Cargo.toml: written")
else:
    print("core Cargo.toml: already present")

# 2. key_manager.rs — add pub mod encryption
p = "crates/zegion-core/src/safety/key_manager.rs"
s = open(p).read()
if "pub mod encryption" not in s:
    marker = '//! deployments should persist to a secure key store via [`KeyManager::persist_to_file`].\n\nuse std::collections::{HashMap, HashSet};'
    repl = ('//! deployments should persist to a secure key store via [`KeyManager::persist_to_file`].\n\n'
            '/// Encryption-at-rest module (S3).  Declared here (rather than in\n'
            '/// `lib.rs`) so that the safety/crypto modules stay grouped without touching\n'
            '/// the crate root.  Resolves to `safety/encryption.rs` via `#[path]`.\n'
            '#[path = "encryption.rs"]\n'
            'pub mod encryption;\n\n'
            'use std::collections::{HashMap, HashSet};')
    s = s.replace(marker, repl, 1)
    open(p,"w").write(s)
    print("key_manager.rs: written")
else:
    print("key_manager.rs: already present")

# 3. persistence Cargo.toml — add zegion-core optional dep + encryption feature
p = "crates/zegion-persistence/Cargo.toml"
s = open(p).read()
if "zegion-core" not in s:
    s = s.replace(
        'uuid = { workspace = true }\n',
        'uuid = { workspace = true }\n\n# Encryption at rest (S3).  Optional — only pulled in when the `encryption`\n# feature is enabled.  Reuses zegion-core\'s `DataEncryptor` (AES-256-GCM).\nzegion-core = { path = "../zegion-core", optional = true }\n\n[features]\ndefault = []\n# Enable encryption at rest for snapshot/training-data files.\nencryption = ["dep:zegion-core", "zegion-core/encryption"]\n',
        1)
    open(p,"w").write(s)
    print("persistence Cargo.toml: written")
else:
    print("persistence Cargo.toml: already present")
