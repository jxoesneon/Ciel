import struct, os, glob

# Check for JSON files alongside NROs
nro_dirs = set()
for root, dirs, files in os.walk('/Volumes/SWITCH/switch'):
    for f in files:
        if f.endswith('.nro') and not f.startswith('._'):
            nro_dirs.add(root)

print("=== JSON/version files alongside NROs ===")
for d in sorted(nro_dirs):
    for f in os.listdir(d):
        if f.endswith(('.json', '.txt', '.ver', '.version', '.cfg', '.ini')) and not f.startswith('._'):
            fpath = os.path.join(d, f)
            try:
                content = open(fpath, 'r', errors='replace').read()[:500]
                print(f"\n{fpath}:")
                print(content[:300])
            except:
                print(f"\n{fpath}: (binary)")

# Also check for romfs-based version files
print("\n=== Checking NACP version strings for all NROs ===")
for root, dirs, files in os.walk('/Volumes/SWITCH'):
    for f in sorted(files):
        if f.endswith('.nro') and not f.startswith('._'):
            path = os.path.join(root, f)
            try:
                data = open(path, 'rb').read()
                base = 0
                if data[0:4] != b'NRO0':
                    idx = data.find(b'NRO0')
                    if idx == -1: continue
                    base = idx
                d = data[base:]
                aset_idx = d.find(b'ASET')
                if aset_idx == -1: continue
                nacp_off = struct.unpack_from('<Q', d, aset_idx + 24)[0]
                nacp_size = struct.unpack_from('<Q', d, aset_idx + 32)[0]
                nacp_abs = aset_idx + nacp_off
                if nacp_abs + 0x3020 <= len(d):
                    nb = b'\x00'
                    title = d[nacp_abs:nacp_abs+0x200].split(nb)[0].decode('utf-8', errors='replace')
                    author = d[nacp_abs+0x200:nacp_abs+0x300].split(nb)[0].decode('utf-8', errors='replace')
                    version = d[nacp_abs+0x3000:nacp_abs+0x3010].split(nb)[0].decode('utf-8', errors='replace')
                    prodcode = d[nacp_abs+0x3010:nacp_abs+0x3020].split(nb)[0].decode('utf-8', errors='replace')
                    rel = path.replace('/Volumes/SWITCH/', '')
                    verstr = version if version else '(empty)'
                    pcstr = f' [prod: {prodcode}]' if prodcode else ''
                    print(f"{rel}: {title} by {author} - v{verstr}{pcstr}")
            except Exception as e:
                print(f"{path}: ERROR {e}")
