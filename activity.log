import re

with open('crates/zegion-dashboard/src/providers.rs', 'r', encoding='utf-8') as f:
    content = f.read()

new_func = '''/// Search the HuggingFace Hub datasets API with native filtering and
/// cursor-based pagination.
///
/// API: `GET https://huggingface.co/api/datasets`
/// Native filters used:
/// - `search={query}` -- full-text search
/// - `filter=modality:{tag}` -- tag-based filter (one per modality tag)
/// - `sort=downloads|lastModified` + `direction=-1`
/// - `limit={n}` -- results count (max 1000 per request)
/// - `full=true` -- get complete metadata (tags, cardData, size)
///
/// HF caps each request at 1000 results. For queries that match more, we
/// follow the `Link: rel="next"` cursor header to fetch additional pages
/// until `limit` is reached or no more results are available.
///
/// Rate limit: 500 req/hr anonymous, 2500 req/hr with HF_TOKEN.
async fn search_huggingface(
    query: String,
    filters: SearchFilters,
    limit: usize,
) -> Vec<DatasetSearchResult> {
    let client = match reqwest::Client::builder().timeout(HTTP_TIMEOUT).build() {
        Ok(c) => c,
        Err(e) => {
            tracing::warn!("HF: failed to build HTTP client: {}", e);
            return Vec::new();
        }
    };

    let (sort_field, direction) = hf_sort_params(filters.sort.as_deref());
    let tags = parse_tags(filters.tags.as_deref());

    let filter_str: String = tags
        .iter()
        .map(|t| format!("modality:{}", t))
        .collect::<Vec<_>>()
        .join(",");

    let mut results: Vec<DatasetSearchResult> = Vec::new();
    let page_size = limit.min(1000);
    let mut url: Option<String> = Some(build_hf_search_url(
        &query,
        page_size,
        sort_field,
        direction,
        &filter_str,
    ));

    // Safety bound: max 5 paginated requests (up to 5000 results).
    for _page in 0..5 {
        let current_url = match url.take() {
            Some(u) => u,
            None => break,
        };

        let resp = match client
            .get(&current_url)
            .header("Accept", "application/json")
            .send()
            .await
        {
            Ok(r) => r,
            Err(e) => {
                tracing::warn!("HF: request failed: {}", e);
                break;
            }
        };

        if !resp.status().is_success() {
            tracing::warn!("HF: HTTP {}", resp.status());
            break;
        }

        // Extract the next-page cursor from the Link header before consuming the body.
        let next_url = parse_hf_next_link(
            resp.headers().get("link").and_then(|v| v.to_str().ok()),
        );

        let items: Vec<HfDataset> = match resp.json().await {
            Ok(v) => v,
            Err(e) => {
                tracing::warn!("HF: JSON parse failed: {}", e);
                break;
            }
        };

        if items.is_empty() {
            break;
        }

        for d in items {
            results.push(map_hf_dataset(d));
            if results.len() >= limit {
                break;
            }
        }

        if results.len() >= limit {
            break;
        }

        url = next_url;
    }

    if results.len() > limit {
        results.truncate(limit);
    }

    // Enrich results with sizes from the datasets-server before returning.
    enrich_sizes(results).await
}'''

old_pattern = r'/// Search the HuggingFace Hub datasets API.*?enrich_sizes\(results\)\.await\n\}'
new_content = re.sub(old_pattern, new_func, content, count=1, flags=re.DOTALL)

if new_content == content:
    print("ERROR: No replacement made")
else:
    with open('crates/zegion-dashboard/src/providers.rs', 'w', encoding='utf-8') as f:
        f.write(new_content)
    print("SUCCESS: search_huggingface replaced")
