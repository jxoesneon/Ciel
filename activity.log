;handheld_charging_official_cpu=2091  ;(D) Erista max, requires UV3-5
;handheld_charging_official_mem=1894  ;(D) beyond JEDEC
;handheld_charging_official_mem=1996  ;(D) dangerous for Erista
;docked_cpu=1963    ;(D) dangerous for Erista
;docked_cpu=2091    ;(D) Erista max, requires UV3-5
;docked_gpu=1075    ;(D) very dangerous
;docked_mem=1894    ;(D) beyond JEDEC
;docked_mem=1996    ;(D) dangerous for Erista
;docked_mem=2099    ;(D) high risk
;docked_mem=2131    ;(D) extreme risk

[010062E01FE0C000]
; 010062E01FE0C000
handheld_cpu=1887
handheld_gpu=998
handheld_mem=1862
docked_cpu=1887
docked_gpu=998
docked_mem=1862
;handheld_cpu=1963  ;(D) dangerous for Erista
;handheld_cpu=2091  ;(D) Erista max, requires UV3-5
;handheld_mem=1894  ;(D) beyond JEDEC
;handheld_mem=1996  ;(D) dangerous for Erista
;docked_cpu=1963    ;(D) dangerous for Erista
;docked_cpu=2091    ;(D) Erista max, requires UV3-5
;docked_gpu=1075    ;(D) very dangerous
;docked_mem=1894    ;(D) beyond JEDEC
;docked_mem=1996    ;(D) dangerous for Erista
;docked_mem=2099    ;(D) high risk
;docked_mem=2131    ;(D) extreme risk
"""

ftp.storbinary('STOR /config/sys-clk/config.ini', BytesIO(config))
size = ftp.size('/config/sys-clk/config.ini')
print(f"Uploaded clean config.ini ({size} bytes)")

# Verify - check for duplicate active keys per section
lines = []
ftp.retrlines('RETR /config/sys-clk/config.ini', lines.append)

current_section = None
section_keys = {}
for line in lines:
    stripped = line.strip()
    if stripped.startswith('[') and stripped.endswith(']'):
        current_section = stripped
        section_keys[current_section] = []
    elif stripped and not stripped.startswith(';') and '=' in stripped and current_section:
        key = stripped.split('=')[0]
        section_keys[current_section].append(key)

print("\n=== Duplicate key check ===")
has_dupes = False
for section, keys in section_keys.items():
    seen = set()
    dupes = []
    for k in keys:
        if k in seen:
            dupes.append(k)
            has_dupes = True
        seen.add(k)
    if dupes:
        print(f"  {section}: DUPLICATES: {dupes}")
    else:
        print(f"  {section}: OK ({len(keys)} keys)")

if not has_dupes:
    print("\n[OK] No duplicate keys - safe to boot")

# Show active values summary
print("\n=== Active values per section ===")
for section, keys in section_keys.items():
    if section == '[values]':
        continue
    print(f"  {section}: {', '.join(keys)}")

ftp.quit()
PYEOF"}
