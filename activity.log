{"ts":"2026-08-01T19:25:00Z","hook":"PreToolUse","tool":"exec","decision":"approve","reason":"default allow","command":"cd /Users/mey/Zegion && python3 -c "
import re
files = ['README.md', 'AGENTS.md', 'MODEL.md', 'TASKS.md', 'DESIGN.md']
for f in files:
    with open(f, 'r') as fh:
        for i, line in enumerate(fh, 1):
            # Skip code blocks, inline code, and markdown table separators
            stripped = line.strip()
            if stripped.startswith('\`\`\`') or stripped.startswith('|') or stripped.startswith('- [ ]'):
                continue
            # Remove inline code
            clean = re.sub(r'\`[^\`]+\`', '', line)
            # Check for exclamation marks (not in image syntax ![])
            if '!' in clean and not re.search(r'!\[', clean):
                # Filter out lines that are just markdown or code
                exclamations = [m.start() for m in re.finditer(r'!', clean)]
                if exclamations:
                    print(f'{f}:{i}: {line.rstrip()}')
""}
