import ftplib

ftp = ftplib.FTP()
ftp.connect('192.168.100.72', 5000, timeout=10)
ftp.login('anonymous', '')
ftp.set_pasv(True)

# Batch 4: Remaining patches + game overrides
# First the remaining exefs_patches
patches = [
    "SaltyNX_Fixes",
    "audio_mastervolume",
    "bootlogo",
    "es_patches",
    "nfim_ctest",
    "nim_ctest",
]

for p in patches:
    old = f"/atmosphere/exefs_patches/{p}.disabled"
    new = f"/atmosphere/exefs_patches/{p}"
    try:
        ftp.rename(old, new)
        print(f"Enabled patch: {p}")
    except Exception as e:
        print(f"Error enabling patch {p}: {e}")

# Now re-enable all game overrides
import re
