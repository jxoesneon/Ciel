{"ts":"2026-08-02T16:03:24Z","hook":"PreToolUse","tool":"exec","decision":"approve","reason":"network call (auto-approved, user full-autonomy grant)","command":"# Check the actual Atmosphere version more precisely
# The hbmenu v3.6.1 is bundled with Atmosphere 1.10.0+
# Let's check the package3 modification date and look for version strings
stat -f "%Sm" /Volumes/SWITCH/atmosphere/package3 2>/dev/null
echo "=== Look for Atmosphere version in stratosphere.romfs ==="
python3 << 'PYEOF'
import re

with open('/Volumes/SWITCH/atmosphere/stratosphere.romfs', 'rb') as f:
    data = f.read()

# Search for version-like strings: 1.x.x where x can be multi-digit
for m in re.finditer(rb'(1\.\d+\.\d+)', data):
    start = max(0, m.start() - 30)
    end = min(len(data), m.end() + 30)
    ctx = data[start:end]
    if all(c < 128 or c == 0 for c in ctx):
        ctx_str = ctx.replace(b'\x00', b' ').decode('ascii', errors='replace').strip()
        # Filter out known non-atmosphere versions
        if not any(x in ctx_str for x in ['curl', 'glfw', 'mesa', 'newlib', 'SDL', 'zlib', 'libpng']):
            print(f"  0x{m.start():x}: {ctx_str}")
PYEOF"}
