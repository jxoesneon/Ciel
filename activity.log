        print(f"OK: {rel} ({size//1024}KB)")
    else:
        print(f"MISSING: {rel}")

# Verify DBI translation.bin
print("\n=== DBI translation ===")
path = os.path.join(SD, "switch/DBI_ENG/translation.bin")
if os.path.exists(path):
    print(f"OK: translation.bin ({os.path.getsize(path)//1024}KB)")
else:
    print("MISSING: translation.bin")

# Count total RetroArch cores
print("\n=== RetroArch cores ===")
cores_dir = os.path.join(SD, "retroarch/cores")
if os.path.exists(cores_dir):
    cores = [f for f in os.listdir(cores_dir) if f.endswith('.nro') and not f.startswith('._')]
    print(f"Total cores: {len(cores)}")
