                    size: "Variable".to_string(),
                    modality: "Tabular".to_string(),
                    format: d["format"].as_str().unwrap_or("ARFF").to_string(),
                    license: "Public Domain".to_string(),
                });
            }

            // If we got fewer than a full batch, no more results.
            if datasets.len() < batch_size {
                break;
            }
        }

        Ok(all_results)
