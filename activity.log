{"ts":"2026-08-01T03:50:46Z","hook":"PreToolUse","tool":"exec","decision":"approve","reason":"low-risk known pattern","command":"# Check the OBJ mesh quality - verify vertex/face counts per category
python3 -c "
import os
categories = ['cube', 'sphere', 'cylinder', 'cone', 'pyramid', 'torus']
for cat in categories:
    files = [f for f in os.listdir(f'/Users/mey/Zegion/datasets/synthetic_3d/model/{cat}') if f.endswith('.obj')]
    if files:
        with open(f'/Users/mey/Zegion/datasets/synthetic_3d/model/{cat}/{files[0]}') as f:
            content = f.read()
        verts = content.count('v ')
        faces = content.count('f ')
        print(f'{cat}: {verts} vertices, {faces} faces ({len(files)} meshes)')
""}
