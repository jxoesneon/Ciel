for file in $(grep -rl "\.unwrap()" crates/*/src/ 2>/dev/null | grep -v "/target/"); do
  # Get unwrap lines that are NOT inside #[cfg(test)] modules
  python3 -c "
import re, sys
with open('$file') as f:
    content = f.read()
    lines = content.split('\n')
    # Find the line where #[cfg(test)] starts
    test_start = None
    for i, line in enumerate(lines):
        if '#[cfg(test)]' in line:
            test_start = i
            break
    for i, line in enumerate(lines):
        if '.unwrap()' in line and 'unwrap_or' not in line and 'unwrap_default' not in line:
            if test_start is not None and i >= test_start:
                continue  # Skip test code
            print(f'$file:{i+1}: {line.strip()}')
" 2>/dev/null
done | head -40"}
