import ftplib
import os

ftp = ftplib.FTP()
ftp.connect('192.168.100.10', 5000, timeout=10)
ftp.login('anonymous', '')
ftp.set_pasv(True)

# Check if file exists
files = ftp.nlst()
fw_files = [f for f in files if 'firmware' in f.lower() or 'Firmware' in f]
print(f"Files matching 'firmware': {fw_files}")

# Try to get the file size
try:
    size = ftp.size('Firmware.22.5.0.zip')
    print(f"Size: {size} bytes ({size//1024//1024}MB)")
except Exception as e:
    print(f"SIZE error: {e}")

# Try RETR
local_path = '/tmp/fw225/Firmware.22.5.0.zip'
os.makedirs('/tmp/fw225', exist_ok=True)

try:
    with open(local_path, 'wb') as f:
        ftp.retrbinary(f'RETR Firmware.22.5.0.zip', f.write)
    local_size = os.path.getsize(local_path)
    print(f"Downloaded: {local_size} bytes ({local_size//1024//1024}MB)")
except Exception as e:
    print(f"RETR error: {e}")

ftp.quit()
PYEOF"}
