{"ts":"2026-08-02T15:50:53Z","hook":"PreToolUse","tool":"exec","decision":"approve","reason":"default allow","command":"# Find Atmosphere version - search all atmosphere binaries
python3 << 'PYEOF'
import re, os

# Search package3 and stratosphere.romfs for version strings
for binpath in ['/Volumes/SWITCH/atmosphere/package3', '/Volumes/SWITCH/atmosphere/stratosphere.romfs']:
    if not os.path.exists(binpath):
        continue
    with open(binpath, 'rb') as f:
        data = f.read()
    
    # Search for strings like "1.x.x" that could be Atmosphere version
    # Atmosphere versions: 1.5.x, 1.6.x, 1.7.x, 1.8.x, 1.9.x
    for m in re.finditer(rb'[Vv]?(1\.[5-9]\.\d+)', data):
        start = max(0, m.start() - 20)
        end = min(len(data), m.end() + 20)
        ctx = data[start:end]
        if all(c < 128 or c == 0 for c in ctx):
            ctx_str = ctx.replace(b'\x00', b' ').decode('ascii', errors='replace').strip()
            print(f"{os.path.basename(binpath)} 0x{m.start():x}: {ctx_str}")

# Also check the hbl.nsp
with open('/Volumes/SWITCH/atmosphere/hbl.nsp', 'rb') as f:
    data = f.read()
for m in re.finditer(rb'[Vv]?(1\.[5-9]\.\d+)', data):
    start = max(0, m.start() - 20)
    end = min(len(data), m.end() + 20)
    ctx = data[start:end]
    if all(c < 128 or c == 0 for c in ctx):
        ctx_str = ctx.replace(b'\x00', b' ').decode('ascii', errors='replace').strip()
        print(f"hbl.nsp 0x{m.start():x}: {ctx_str}")

# Check reboot_payload.bin for hekate version (already found v6.5.2)
# Also check for Atmosphere version in the payload
with open('/Volumes/SWITCH/atmosphere/reboot_payload.bin', 'rb') as f:
    data = f.read()
for m in re.finditer(rb'hekate\s+[Vv]?(\d+\.\d+\.\d+)', data):
    print(f"reboot_payload: {m.group(0).decode()}")
for m in re.finditer(rb'[Vv]?(1\.[5-9]\.\d+)', data):
    start = max(0, m.start() - 20)
    end = min(len(data), m.end() + 20)
    ctx = data[start:end]
    if all(c < 128 or c == 0 for c in ctx):
        ctx_str = ctx.replace(b'\x00', b' ').decode('ascii', errors='replace').strip()
        if 'hekate' not in ctx_str.lower():
            print(f"reboot_payload 0x{m.start():x}: {ctx_str}")
PYEOF"}
