# Emoji pattern
emoji_pattern = re.compile(
    '['
    '\U0001F300-\U0001F9FF'
    '\U00002600-\U000027BF'
    '\U0000FE00-\U0000FE0F'
    '\U0000200D'
    '\U00002139\U0000231A\U0000231B\U000023E9-\U000023F3\U000023F8-\U000023FA\U000025AB\U000025AC\U000025B6\U000025C0\U000025FB-\U000025FE\U00002614\U00002615\U00002648-\U00002653\U0000267F\U00002693\U000026A1\U000026AA\U000026AB\U000026BD\U000026BE\U000026C4\U000026C5\U000026CE\U000026D4\U000026EA\U000026F2\U000026F3\U000026F5\U000026FA\U000026FD'
    '\U00002705\U00002708-\U00002712\U00002714\U00002716\U0000271D\U00002721\U00002728\U00002733\U00002734\U00002744\U00002747\U0000274C\U0000274E\U00002753-\U00002755\U00002757\U00002763\U00002764\U00002795-\U00002797\U000027A1\U000027B0\U000027BF'
    '\U00002934\U00002935\U00002B05-\U00002B07\U00002B1B\U00002B1C\U00002B50\U00002B55'
    '\U00003030\U0000303D\U00003297\U00003299'
    ']'
)

# Strategy: replace "emoji + space" with "" (removing both emoji and the trailing space)
# and replace standalone emoji with ""
# This handles cases like "✅ Text" -> "Text" and "✅" -> ""
new_content = emoji_pattern.sub('', content)

# Now fix double spaces that may have resulted from "emoji  Text" (emoji + 2 spaces)
# or from emoji removal leaving extra spaces
# Pattern: after a quote, multiple spaces -> single space
new_content = re.sub(r'(")\s{2,}', r'\1 ', new_content)

# Also fix cases where emoji was at start of string followed by space then text
# e.g. "🧠 Zegion" -> " Zegion" -> "Zegion"  
# But only when the space is right after a quote
new_content = re.sub(r'"\s+([A-Za-z])', r'"\1', new_content)

# Fix cases in info! where emoji was followed by space then text inside the string
# e.g. info!("✅ All system...") -> info!("All system...")  -- already handled above
# But also: "✅ PDF exported" -> "PDF exported" -- handled

# Also handle the case where emoji was in the middle: "  • [RFC-001]" -- bullet is not emoji, keep it
# Handle "⚠️ Unsupported" -> "Unsupported" (⚠️ is emoji, already removed, now " Unsupported" -> "Unsupported")
# Already handled by the quote-space pattern

# Let's also handle the ↔ which is NOT an emoji (it's an arrow symbol used in code logic)
# and • which is a bullet point, not emoji

with open('/Users/mey/Zegion/src/main.rs', 'w') as f:
    f.write(new_content)

# Verify
remaining = emoji_pattern.findall(new_content)
print(f'Removed emojis. Remaining emoji count: {len(remaining)}')
if remaining:
    print(f'Remaining: {remaining}')
PYEOF"}
