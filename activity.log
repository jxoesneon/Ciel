{"ts":"2026-08-02T07:49:31Z","hook":"PreToolUse","tool":"exec","decision":"approve","reason":"default allow","command":"cd /Users/mey/Zegion && python3 << 'PYEOF'
import re

with open('crates/zegion-dashboard/src/providers.rs', 'r', encoding='utf-8') as f:
    content = f.read()

# Find the search_huggingface function and replace it
# Match from "/// Search the HuggingFace Hub datasets API" to the end of the function (enrich_sizes(results).await\n})
old_pattern = r'/// Search the HuggingFace Hub datasets API.*?enrich_sizes\(results\)\.await\n\}'
match = re.search(old_pattern, content, re.DOTALL)
if match:
