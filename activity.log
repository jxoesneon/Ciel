{"ts":"2026-08-02T17:50:14Z","hook":"PreToolUse","tool":"exec","decision":"approve","reason":"network call (auto-approved, user full-autonomy grant)","command":"python3 << 'PYEOF'
import ftplib

ftp = ftplib.FTP()
ftp.connect('192.168.100.72', 5000, timeout=10)
ftp.login('anonymous', '')
ftp.set_pasv(True)

# Re-enable in batches. Start with the homebrew/overlay infrastructure:
# - nx-ovlloader (420000000007E51A) - needed for overlays
# - Ultrahand ovlmenu (420000000007E51B)
# - sys-patch (420000000000000B) - ES patches, needed for game installs
# - sys-ftpd (420000000000000E) - FTP (we're using it now)

batch1 = [
    "420000000007E51A",  # nx-ovlloader
    "420000000007E51B",  # Ultrahand ovlmenu
    "420000000000000B",  # sys-patch
    "420000000000000E",  # sys-ftpd
]

for tid in batch1:
    old = f"/atmosphere/contents/{tid}.disabled"
    new = f"/atmosphere/contents/{tid}"
    try:
        ftp.rename(old, new)
        print(f"Enabled {tid}")
    except Exception as e:
        print(f"Error enabling {tid}: {e}")

ftp.quit()
print("\nBatch 1 enabled. Reboot and test.")
PYEOF"}
