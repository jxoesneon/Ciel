const fs = require('fs');
const text = fs.readFileSync('/Users/mey/Zegion/.vscode/launch.json', 'utf8');
// Strip JSONC comments
const clean = text.replace(/\/\/.*$/gm, '').replace(/\/\*[\s\S]*?\*\//g, '');
const parsed = JSON.parse(clean);
console.log('Valid JSONC');
console.log(parsed.configurations.length + ' configurations');
parsed.configurations.forEach(c => {
  console.log('  ' + c.name + ': ' + c.cargo.args.join(' '));
});
""}
