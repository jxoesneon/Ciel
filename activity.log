ftp = ftplib.FTP()
ftp.connect('192.168.100.10', 5000, timeout=10)
ftp.login('anonymous', '')
ftp.set_pasv(True)

# Create FW-22.5.0 directory at root
try:
    ftp.mkd('/FW-22.5.0')
    print("Created /FW-22.5.0")
except Exception as e:
