old_trait = """/// Trait implemented by each dataset registry probe.
pub trait ResolutionProbe: Send + Sync {
    /// Display name of the registry.
    fn name(&self) -> &str;
    /// Query the registry and return matching datasets.
    fn probe(&self, client: &reqwest::blocking::Client, query: &str) -> Result<Vec<ResolvedDataset>>;
}"""

new_trait = """/// Trait implemented by each dataset registry probe.
pub trait ResolutionProbe: Send + Sync {
    /// Display name of the registry.
    fn name(&self) -> &str;
    /// Query the registry and return matching datasets.
    ///
    /// The `guard` parameter provides SSRF protection — every probe MUST call
    /// [`validate_url`] before issuing any HTTP request and return an empty
    /// vector if the URL is blocked.
    fn probe(
        &self,
        client: &reqwest::blocking::Client,
        guard: &ScrapingGuard,
        query: &str,
    ) -> Result<Vec<ResolvedDataset>>;
}

/// Validate a URL against the [`ScrapingGuard`] SSRF and robots.txt checks.
///
/// Returns `Ok(true)` when the URL is safe to fetch, `Ok(false)` when it is
/// blocked or the check fails (a warning is logged in both cases).  The
/// caller should return an empty result vector when this returns `false`.
fn validate_url(guard: &ScrapingGuard, url: &str) -> Result<bool, ScrapingError> {
    match guard.check_url(url) {
        Ok(ScrapingTier::None) => {
            tracing::warn!(url = %url, "SSRF check blocked URL");
            Ok(false)
        }
        Ok(_) => Ok(true),
        Err(e) => {
            tracing::warn!(url = %url, error = %e, "SSRF check failed");
            Ok(false)
        }
    }
}"""

