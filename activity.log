import struct, sys, os

def parse_nro(path):
    try:
        with open(path, 'rb') as f:
            data = f.read()
    except Exception as e:
        return f"ERROR: {e}"

    if len(data) < 0x70:
        return "ERROR: too small for NRO header"

    magic = data[0:4]
    if magic != b'NRO0':
        return f"ERROR: not an NRO (magic={magic})"

    # NRO header
    nro_version = struct.unpack_from('<I', data, 0x4)[0]
    header_size = struct.unpack_from('<I', data, 0xC)[0]

    # Segment sizes
    text_size = struct.unpack_from('<I', data, 0x18)[0]
    ro_size = struct.unpack_from('<I', data, 0x20)[0]
    data_size = struct.unpack_from('<I', data, 0x28)[0]

    # The ASET section is at the end of the NRO, right after all segments
    # Total NRO content = header_size + text + ro + data (aligned)
    # But actually the ASET is appended after the full NRO
    # Let's search for ASET magic
    aset_off = None
    # ASET is typically at offset header_size + text_size + ro_size + data_size
    # but segments may be aligned. Let's search for the magic.
    search_start = header_size + text_size + ro_size + data_size - 0x1000
    if search_start < 0:
        search_start = 0
    idx = data.find(b'ASET', search_start)
    if idx == -1:
        # broader search
        idx = data.find(b'ASET')
    if idx == -1:
        return f"NRO fmt v{nro_version}, no ASET section (no version info available)"

    aset_off = idx
    if aset_off + 0x20 > len(data):
        return "ASET section truncated"

    aset_version = struct.unpack_from('<I', data, aset_off + 4)[0]
    icon_off = struct.unpack_from('<I', data, aset_off + 8)[0]
    icon_size = struct.unpack_from('<I', data, aset_off + 12)[0]
    nacp_off = struct.unpack_from('<I', data, aset_off + 16)[0]
    nacp_size = struct.unpack_from('<I', data, aset_off + 20)[0]
    romfs_off = struct.unpack_from('<I', data, aset_off + 24)[0]
    romfs_size = struct.unpack_from('<I', data, aset_off + 28)[0]

    # NACP version string is at offset 0x3000 within the NACP
    nacp_abs = aset_off + nacp_off
    if nacp_size > 0 and nacp_abs + 0x3010 <= len(data):
        version = data[nacp_abs + 0x3000 : nacp_abs + 0x3010].split(b'\x00')[0].decode('utf-8', errors='replace').strip()
        # Also get the title name from the first TitleEntry
        title = data[nacp_abs : nacp_abs + 0x200].split(b'\x00')[0].decode('utf-8', errors='replace').strip()
        return f"v{version} (title: {title})" if version else f"ASET v{aset_version}, no version string (title: {title})"
    else:
        return f"ASET v{aset_version}, NACP not present or too small"

nros = []
for line in sys.stdin:
    nros.append(line.strip())

for path in nros:
    result = parse_nro(path)
    # Make path relative to /Volumes/SWITCH
    rel = path.replace('/Volumes/SWITCH/', '')
    print(f"{rel}: {result}")
