    '3.3.4': ['SimpleModDownloader', 'aio-switch-updater', 'sys-clk-manager'],
    '20.1.0': ['botw-unexplored', 'totk-unexplored'],
}

for ver, apps in suspicious.items():
    print(f"\n=== Checking version {ver} ===")
    pattern = rb'[Vv]?' + ver.replace('.', rb'\.').encode()
    for app in apps:
        # Find the NRO file
