import urllib.request, json, ssl
ctx = ssl.create_default_context()
url = 'https://api.datacite.org/dois?query=climate&page[size]=3&types.resourceTypeGeneral=Dataset'
req = urllib.request.Request(url, headers={'Accept': 'application/vnd.api+json', 'User-Agent': 'Mozilla/5.0'})
with urllib.request.urlopen(req, timeout=15, context=ctx) as resp:
    data = json.loads(resp.read())
    print('total:', data.get('meta',{}).get('total'))
    print('results:', len(data.get('data',[])))
    if data.get('data'):
        attrs = data['data'][0].get('attributes',{})
        print('sample title:', attrs.get('titles',[{}])[0].get('title','')[:100])
" 2>&1"}
