# Check pad-macro - could also conflict with bluetooth/controllers
echo "=== pad-macro ==="
ls -la "$SD/atmosphere/contents/0100000000C0FFEE/" 2>/dev/null
python3 -c "
import re
with open('$SD/atmosphere/contents/0100000000C0FFEE/exefs.nsp', 'rb') as f:
    data = f.read()
for m in re.finditer(rb'[Vv]?(\d+\.\d+(?:\.\d+)?[a-z]?)', data):
    ver = m.group(1).decode()
    if len(ver) >= 3:
        start = max(0, m.start() - 20)
        end = min(len(data), m.end() + 20)
        ctx = data[start:end].replace(b'\x00', b' ').decode('ascii', errors='replace').strip()
        if any(x in ctx.lower() for x in ['pad', 'macro', 'version']):
            print(f'  {ver}: {ctx[:60]}')
" 2>/dev/null

# Final sync
echo ""
sync
echo "Synced"

# Summary of all changes made
echo ""
echo "=== Summary of fixes ==="
echo "1. Added 2 missing bluetooth_patches for FW 22.5.0"
echo "2. Added 2 missing hid_patches for FW 22.5.0"
echo "3. Removed sys-con v0.6 (conflicted with MissionControl)"
echo "4. Removed duplicate sys-ftpd-freeze"
