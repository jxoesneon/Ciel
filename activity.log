print(f"  .cnmt.nca files: {len(cnmt_files)}")

# Verify a few file sizes
import os
local_dir = '/tmp/fw225/fw_extracted'
local_files = sorted([f for f in os.listdir(local_dir) if not f.startswith('._')])
remote_files = sorted([os.path.basename(f) for f in files])

mismatches = 0
for fname in local_files[:10]:
    local_size = os.path.getsize(os.path.join(local_dir, fname))
    try:
        remote_size = ftp.size(f'/FW-22.5.0/{fname}')
        match = "OK" if local_size == remote_size else "MISMATCH"
        if local_size != remote_size:
            mismatches += 1
        print(f"  {fname}: local={local_size} remote={remote_size} {match}")
    except Exception as e:
        print(f"  {fname}: error checking size: {e}")

# Check if local and remote file lists match
missing = set(local_files) - set(remote_files)
extra = set(remote_files) - set(local_files)
if missing:
    print(f"\nMissing on remote: {len(missing)} files")
if extra:
    print(f"Extra on remote: {len(extra)} files")
if not missing and not extra:
    print(f"\nAll {len(local_files)} files verified on Switch")

ftp.quit()
