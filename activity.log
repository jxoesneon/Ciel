import ftplib

ftp = ftplib.FTP()
ftp.connect('192.168.100.72', 5000, timeout=10)
ftp.login('anonymous', '')
ftp.set_pasv(True)

# Re-enable half the game cheat folders to narrow down
contents = ftp.nlst('/atmosphere/contents/')
disabled = sorted([c for c in contents if c.endswith('.disabled') and c.startswith('/atmosphere/contents/0100')])

# Split into two halves
mid = len(disabled) // 2
batch = disabled[:mid]

print(f"Re-enabling first {len(batch)} of {len(disabled)} game folders...")
for d in batch:
    tid = d.split('/')[-1].replace('.disabled', '')
    try:
        ftp.rename(d, d.replace('.disabled', ''))
        print(f"  {tid}")
    except Exception as e:
        print(f"  ERROR {tid}: {e}")

ftp.quit()
print(f"\nEnabled {len(batch)} folders. Reboot and test.")
PYEOF"}
