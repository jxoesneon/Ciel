    d for d in os.listdir('/Users/meilynlopezcubero/.gemini/antigravity/brain/2041938c-35f0-4222-aeae-ef17496d6669/.system_generated/worktrees/')
    if d.startswith('subagent-')
])

for wt in worktrees:
    wt_path = f'/Users/meilynlopezcubero/.gemini/antigravity/brain/2041938c-35f0-4222-aeae-ef17496d6669/.system_generated/worktrees/{wt}'
    result = subprocess.run(['git', '-C', wt_path, 'diff', '--name-only'], capture_output=True, text=True)
    files = [f for f in result.stdout.strip().split('\n') if f and not f.startswith('.') and not f.endswith('.cjs') and not f.endswith('.py') and not f.endswith('.js') and not f.endswith('.txt') and not f.startswith('patch_')]
