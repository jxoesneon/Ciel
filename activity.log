# WCAG contrast ratio calculator
def luminance(hex_color):
    hex_color = hex_color.lstrip('#')
    r, g, b = [int(hex_color[i:i+2], 16) / 255 for i in (0, 2, 4)]
    def adjust(c):
        return c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4
    return 0.2126 * adjust(r) + 0.7152 * adjust(g) + 0.0722 * adjust(b)

def contrast_ratio(c1, c2):
    l1 = luminance(c1)
    l2 = luminance(c2)
    lighter = max(l1, l2)
    darker = min(l1, l2)
    return (lighter + 0.05) / (darker + 0.05)

# Key color pairs
pairs = [
    ('Paper on Ink (primary text)', '#F1EDE2', '#191A1C'),
    ('Paper on Ink-Raised', '#F1EDE2', '#242629'),
    ('Dim on Ink (muted text)', '#9D998E', '#191A1C'),
    ('Dim on Ink-Raised', '#9D998E', '#242629'),
    ('Powder-Blue on Ink (focus)', '#AFC7D7', '#191A1C'),
    ('Powder-Blue on Ink-Raised', '#AFC7D7', '#242629'),
    ('Dim on Sidebar', '#9D998E', '#1D1E21'),
    ('Paper on Sidebar', '#F1EDE2', '#1D1E21'),
    ('Powder-Lilac on Ink', '#C6B6CF', '#191A1C'),
    ('Powder-Mint on Ink', '#B8CFB5', '#191A1C'),
    ('Powder-Peach on Ink', '#D7B59D', '#191A1C'),
    ('Blue-1 on Ink (chart)', '#7C91A0', '#191A1C'),
    ('Ink on Powder-Blue', '#191A1C', '#AFC7D7'),
    ('Text-on-blue on Powder-Blue', '#28231F', '#AFC7D7'),
    ('Paper on Plot', '#F1EDE2', '#24282D'),
    ('Dim on Plot', '#9D998E', '#24282D'),
    ('Dim on Divider', '#9D998E', '#3A3C40'),
    # High contrast theme
    ('HC: Paper on Ink (light)', '#1A1B1E', '#F5F2EC'),
    ('HC: Dim on Ink (light)', '#4A4A4A', '#F5F2EC'),
    # Midnight theme
    ('Mid: Paper on Ink', '#F1EDE2', '#0A0B0C'),
    ('Mid: Dim on Ink', '#9D998E', '#0A0B0C'),
]

for name, fg, bg in pairs:
    ratio = contrast_ratio(fg, bg)
    normal_pass = 'PASS' if ratio >= 4.5 else 'FAIL'
    large_pass = 'PASS' if ratio >= 3.0 else 'FAIL'
    print(f'{name}: {ratio:.2f}:1  | Normal text: {normal_pass} | Large text: {large_pass}')
""}
