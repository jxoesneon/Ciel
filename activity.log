SD="/Volumes/SWITCH"
U="/tmp/nro_updates/extracted/hekate"
U="/tmp/nro_updates/extracted/atmosphere"


# Update Hekate payload (the main boot payload)
# Backup current Atmosphere config files first
cp "$U/hekate_ctcaer_6.5.3.bin" "$SD/bootloader/update.bin" && echo "Hekate update.bin: OK" || echo "Hekate update.bin: FAIL"
echo "=== Backing up config files ==="

mkdir -p /tmp/nro_updates/atmosphere_backup
# Also copy to payloads directory if it exists
cp "$SD/atmosphere/config/exosphere.ini" /tmp/nro_updates/atmosphere_backup/ 2>/dev/null && echo "exosphere.ini backed up"
# The hekate_ctcaer_6.5.3.bin should be the payload that goes into bootloader/update.bin
cp "$SD/atmosphere/config/system_settings.ini" /tmp/nro_updates/atmosphere_backup/ 2>/dev/null && echo "system_settings.ini backed up"
# or it could be placed as the main hekate payload
cp "$SD/atmosphere/config/override_config.ini" /tmp/nro_updates/atmosphere_backup/ 2>/dev/null

cp "$SD/atmosphere/config/stratosphere.ini" /tmp/nro_updates/atmosphere_backup/ 2>/dev/null
# Update Hekate sys modules

cp "$U/bootloader/sys/thk.bin" "$SD/bootloader/sys/thk.bin" && echo "thk.bin: OK" || echo "thk.bin: FAIL"
# Update Atmosphere core files
cp "$U/bootloader/sys/emummc.kipm" "$SD/bootloader/sys/emummc.kipm" 2>/dev/null && echo "emummc.kipm: OK" || echo "emummc.kipm: skip"
echo "=== Updating Atmosphere core files ==="
cp "$U/bootloader/sys/libsys_lp0.bso" "$SD/bootloader/sys/libsys_lp0.bso" 2>/dev/null && echo "libsys_lp0.bso: OK"
cp "$U/atmosphere/package3" "$SD/atmosphere/package3" && echo "package3: OK" || echo "package3: FAIL"
