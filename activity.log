    seen = set()
    dupes = []
    for k in keys:
        if k in seen:
            dupes.append(k)
            has_dupes = True
        seen.add(k)
    if dupes:
        print(f"  {section}: DUPLICATES: {dupes}")
    else:
        print(f"  {section}: OK ({len(keys)} keys)")

