print(f"RomFS offset: 0x{romfs_off:x}, size: 0x{romfs_size:x}")

# NACP absolute position in d
nacp_abs = aset_idx + nacp_off
print(f"\nNACP absolute in d: 0x{nacp_abs:x}")
print(f"NACP end: 0x{nacp_abs + nacp_size:x}")
