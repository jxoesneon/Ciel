{"ts":"2026-08-02T16:03:08Z","hook":"PreToolUse","tool":"exec","decision":"approve","reason":"low-risk known pattern","command":"# Check Switch firmware version from Atmosphere settings
cat /Volumes/SWITCH/atmosphere/config/system_settings.ini 2>/dev/null | grep -i "firmware\|version\|hos"
echo "=== check exosphere.ini ==="
cat /Volumes/SWITCH/atmosphere/config/exosphere.ini 2>/dev/null
cat /Volumes/SWITCH/atmosphere/config_templates/exosphere.ini 2>/dev/null
echo "=== hekate_ipl.ini full ==="
cat /Volumes/SWITCH/bootloader/hekate_ipl.ini 2>/dev/null
echo "=== check all toolbox.json files for sysmodule versions ==="
find /Volumes/SWITCH/atmosphere/contents -name "toolbox.json" -not -name "._*" 2>/dev/null | while read f; do
    echo "--- $f ---"
    cat "$f" 2>/dev/null
    echo ""
done"}
