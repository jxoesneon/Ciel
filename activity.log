{"ts":"2026-08-02T17:15:40Z","hook":"PreToolUse","tool":"exec","decision":"approve","reason":"network call (auto-approved, user full-autonomy grant)","command":"ls -la /tmp/fw225/Firmware.22.5.0.zip 2>/dev/null | awk '{print $5, $9}'
