{"ts":"2026-08-01T12:12:23Z","hook":"PreToolUse","tool":"exec","decision":"approve","reason":"low-risk known pattern","command":"cd /Users/mey/Zegion && python3 - <<'PY'
p = "crates/zegion-persistence/src/lib.rs"
s = open(p).read()
if "cfg(not(feature = \"encryption\"))\nconst ENCRYPTION_MAGIC" in s:
    print("already present")
else:
    marker = '    EncryptedButNoEncryptor,\n}\n\n/// Result alias for encrypted snapshot operations.'
    repl = ('    EncryptedButNoEncryptor,\n}\n\n'
            '/// Magic byte prefix used to distinguish encrypted from plaintext snapshot\n'
            '/// files on disk.  Mirrors `zegion_core::key_manager::encryption::ENCRYPTION_MAGIC`\n'
            '/// (`ZENC1`); duplicated here so plaintext-only builds (feature off, no\n'
            '/// zegion-core dependency) can still detect and reject encrypted files.\n'
            '#[cfg(not(feature = "encryption"))]\n'
            'const ENCRYPTION_MAGIC: &[u8] = b"ZENC1";\n\n'
            '#[cfg(not(feature = "encryption"))]\n'
            'fn is_encrypted_payload(data: &[u8]) -> bool {\n'
            '    data.len() >= ENCRYPTION_MAGIC.len()\n'
            '        && &data[..ENCRYPTION_MAGIC.len()] == ENCRYPTION_MAGIC\n'
            '}\n\n/// Result alias for encrypted snapshot operations.')
    if marker not in s:
        print("MARKER NOT FOUND")
    else:
        s = s.replace(marker, repl, 1)
        open(p,"w").write(s)
        print("written")
PY
grep -n "const ENCRYPTION_MAGIC\|fn is_encrypted_payload" crates/zegion-persistence/src/lib.rs"}
