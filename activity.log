{"ts":"2026-08-02T08:35:37Z","hook":"PreToolUse","tool":"exec","decision":"approve","reason":"default allow","command":"cd /Users/mey/Zegion && python3 << 'PYEOF'
import re

# Read all drafts
with open('/tmp/draft_datacite.txt') as f: datacite = f.read()
with open('/tmp/draft_crossref.txt') as f: crossref = f.read()
with open('/tmp/draft_figshare.txt') as f: figshare = f.read()
with open('/tmp/draft_dryad.txt') as f: dryad = f.read()
with open('/tmp/draft_ckan.txt') as f: ckan = f.read()

# Extract Rust probe code from each draft
def extract_rust_probe(draft):
    """Extract the pub struct ... } block from a draft."""
    # Find the first /// comment before pub struct, then find the matching closing }
    match = re.search(r'(/// Probe.*?pub struct \w+Probe;.*?^})', draft, re.DOTALL | re.MULTILINE)
    if match:
        return match.group(1)
    return None

datacite_rust = extract_rust_probe(datacite)
crossref_rust = extract_rust_probe(crossref)
figshare_rust = extract_rust_probe(figshare)
dryad_rust = extract_rust_probe(dryad)

# For CKAN, there are two probes
ckan_hdx_rust = extract_rust_probe(ckan)
# Open Canada is the second probe
oc_match = re.search(r'(/// Probe for the Open Canada.*?pub struct OpenCanadaProbe;.*?^})', ckan, re.DOTALL | re.MULTILINE)
ckan_oc_rust = oc_match.group(1) if oc_match else None

print("=== Rust probes extracted ===")
print(f"DataCite: {len(datacite_rust) if datacite_rust else 0} chars")
print(f"Crossref: {len(crossref_rust) if crossref_rust else 0} chars")
print(f"Figshare: {len(figshare_rust) if figshare_rust else 0} chars")
print(f"Dryad: {len(dryad_rust) if dryad_rust else 0} chars")
print(f"HDX: {len(ckan_hdx_rust) if ckan_hdx_rust else 0} chars")
print(f"OpenCanada: {len(ckan_oc_rust) if ckan_oc_rust else 0} chars")

# Verify each starts with /// and ends with }
for name, code in [("DataCite", datacite_rust), ("Crossref", crossref_rust), 
                    ("Figshare", figshare_rust), ("Dryad", dryad_rust),
                    ("HDX", ckan_hdx_rust), ("OpenCanada", ckan_oc_rust)]:
    if code:
        assert code.strip().startswith("///"), f"{name} doesn't start with ///"
        assert code.strip().endswith("}"), f"{name} doesn't end with }}"
    else:
        print(f"WARNING: {name} extraction failed!")

