new_zenodo = '''/// Probe for the Zenodo records API with cursor-based pagination.
///
/// Zenodo caps page size at 25 for anonymous requests. We follow the
/// `links.next` cursor in the response body to fetch additional pages
/// (up to 10 pages = 250 results).
pub struct ZenodoProbe;
impl ResolutionProbe for ZenodoProbe {
    fn name(&self) -> &str {
        "Zenodo"
    }
    fn probe(
        &self,
        client: &reqwest::blocking::Client,
        guard: &ScrapingGuard,
        query: &str,
    ) -> Result<Vec<ResolvedDataset>> {
        let mut all_results: Vec<ResolvedDataset> = Vec::new();
        let mut url: Option<String> = Some(format!(
            "https://zenodo.org/api/records?q={}&size=25&type=dataset",
            query
        ));

        // Safety bound: max 10 pages (up to 250 results).
        for _page in 0..10 {
            let current_url = match url.take() {
                Some(u) => u,
                None => break,
            };
            if !validate_url(guard, &current_url)? {
                break;
            }

            let resp = client.get(&current_url).send()?;
            // Extract next page cursor from response body later.
            let body: serde_json::Value = resp.json()?;

            // Extract the next-page URL from links.next.
            url = body["links"]["next"].as_str().map(|s| s.to_string());

            let hits = match body["hits"]["hits"].as_array() {
                Some(arr) => arr,
                None => break,
            };
            if hits.is_empty() {
                break;
            }

            for d in hits {
                let meta = &d["metadata"];
                let byte_size = d["files"][0]["size"].as_u64().unwrap_or(0);
                let size_str = if byte_size > 1024 * 1024 * 1024 {
                    format!("{:.1} GB", byte_size as f64 / (1024.0 * 1024.0 * 1024.0))
                } else {
                    format!("{:.1} MB", byte_size as f64 / (1024.0 * 1024.0))
                };

                let modality = match meta["resource_type"]["type"].as_str().unwrap_or("") {
                    "dataset" => "Tabular",
                    "image" => "Image",
                    "software" => "Neural",
                    _ => "Scientific",
                };

                all_results.push(ResolvedDataset {
                    source: self.name().to_string(),
                    id: format!("zenodo-{}", d["id"]),
                    title: sanitize_title(meta["title"].as_str().unwrap_or("unknown")),
                    author: sanitize_author(
                        meta["creators"][0]["name"].as_str().unwrap_or("Zenodo"),
                    ),
                    relevance_score: d["stats"]["downloads"].as_u64().unwrap_or(0),
                    relevance_score_label: "Citations".to_string(),
                    tags: vec!["scientific".to_string()],
                    description: sanitize_description(
                        &meta["description"]
                            .as_str()
                            .unwrap_or("")
                            .replace("<[^>]*>", "")
                            .chars()
                            .take(200)
                            .collect::<String>(),
                    ),
                    url: d["links"]["latest_html"].as_str().unwrap_or("").to_string(),
                    size: size_str,
                    modality: modality.to_string(),
                    format: "Binary Cluster".to_string(),
                    license: meta["license"]["id"].as_str().unwrap_or("Open").to_string(),
                });
            }
        }

        Ok(all_results)
    }
}'''

