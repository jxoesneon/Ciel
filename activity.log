{"ts":"2026-08-02T17:26:57Z","hook":"PreToolUse","tool":"exec","decision":"approve","reason":"low-risk known pattern","command":"# Install the nightly ldn_mitm
SD="/Volumes/SWITCH"
N="/tmp/ldn_nightly"

# Backup old version
cp "$SD/atmosphere/contents/4200000000000010/exefs.nsp" /tmp/ldn_mitm_v1.25.1_backup.nsp
echo "Backed up old exefs.nsp"

# Copy new nightly sysmodule
cp "$N/atmosphere/contents/4200000000000010/exefs.nsp" "$SD/atmosphere/contents/4200000000000010/exefs.nsp"
echo "Installed nightly exefs.nsp"

# Copy new ldnmitm_config.nro
cp "$N/switch/ldnmitm_config/ldnmitm_config.nro" "$SD/switch/ldnmitm_config/ldnmitm_config.nro"
echo "Updated ldnmitm_config.nro"

# Verify the overlay - check if the nightly overlay.elf needs to be converted to .ovl
# The overlay artifact is just the .elf, which is the source format
# The .ovl file on SD is the compiled overlay - let's check if we need to update it
echo "=== Current ldnmitm overlay on SD ==="
ls -la "$SD/switch/.overlays/ldnmitm_config.ovl" 2>/dev/null | awk '{print $5, $9}'

# The overlay.elf from GHA is not directly usable - it needs to be converted
# The release zip includes the .ovl already. Let's keep the current .ovl
# since the sysmodule is what's crashing, not the overlay

# Also need to clean up the loose .nca files from the root
echo ""
echo "=== Now cleaning up loose .nca files from root ==="
echo "These are from a previous firmware extraction (FW 20.5.0)"
find "$SD" -maxdepth 1 -name "*.nca" -not -name "._*" -type f | wc -l
echo "files to remove""}
