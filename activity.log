// ---------------------------------------------------------------------------
// Encryption at rest (S3)
// ---------------------------------------------------------------------------

// Re-export the encryption primitives from zegion-core when the `encryption`
// feature is enabled.  When the feature is off, the `SnapshotStore` below is
// still usable but always stores/reads plaintext.
#[cfg(feature = "encryption")]
pub use zegion_core::key_manager::encryption::{
    DataEncryptor, EncryptionConfig, EncryptionError as CoreEncryptionError,
    ENCRYPTION_MAGIC, is_encrypted_payload, strip_magic, with_magic,
};

/// Errors returned by encrypted snapshot operations.
#[derive(Debug, thiserror::Error)]
pub enum SnapshotEncryptionError {
    /// Underlying encryption/decryption failure.
    #[cfg(feature = "encryption")]
    #[error("encryption error: {0}")]
    Encryption(#[from] CoreEncryptionError),

    /// I/O error while reading/writing a snapshot file.
    #[error("io error: {0}")]
    Io(#[from] std::io::Error),

    /// A file on disk carried the encryption magic prefix but no encryptor
    /// was configured (e.g. encryption was disabled after encrypted files
    /// were written).
    #[error("file is encrypted (magic prefix detected) but no encryptor is configured")]
    EncryptedButNoEncryptor,
}

/// Magic byte prefix used to distinguish encrypted from plaintext snapshot
/// files on disk.  Mirrors
/// `zegion_core::key_manager::encryption::ENCRYPTION_MAGIC` (`ZENC1`);
/// duplicated here so plaintext-only builds (feature off, no zegion-core
/// dependency) can still detect and reject encrypted files.
#[cfg(not(feature = "encryption"))]
const ENCRYPTION_MAGIC: &[u8] = b"ZENC1";

#[cfg(not(feature = "encryption"))]
fn is_encrypted_payload(data: &[u8]) -> bool {
    data.len() >= ENCRYPTION_MAGIC.len()
        && &data[..ENCRYPTION_MAGIC.len()] == ENCRYPTION_MAGIC
}

/// Result alias for encrypted snapshot operations.
pub type SnapshotResult<T> = std::result::Result<T, SnapshotEncryptionError>;

/// A file-backed snapshot store with optional encryption at rest (S3).
///
/// When an encryptor is present **and active** (`DataEncryptor::is_active`),
/// snapshot payloads are encrypted with AES-256-GCM before being written to
/// disk, and the `ENCRYPTION_MAGIC` prefix (`ZENC1`) is prepended so that
/// readers can distinguish encrypted from plaintext files.
///
/// When no encryptor is configured (or the `encryption` feature is off, in
/// which case the encryptor is a no-op), payloads are written as plaintext.
/// On read, the magic prefix is detected automatically: encrypted files are
/// decrypted when an encryptor is available, otherwise an error is returned.
#[derive(Debug, Default)]
pub struct SnapshotStore {
    /// Optional encryptor.  `None` means plaintext storage.
    #[cfg(feature = "encryption")]
    encryptor: Option<DataEncryptor>,
}

impl SnapshotStore {
    /// Create a plaintext (unencrypted) snapshot store.
    pub fn plaintext() -> Self {
        Self::default()
    }

    /// Create an encrypted snapshot store wrapping the given encryptor.
    #[cfg(feature = "encryption")]
    pub fn with_encryptor(encryptor: DataEncryptor) -> Self {
        Self {
            encryptor: Some(encryptor),
        }
    }

    /// Create an encrypted snapshot store from an `EncryptionConfig`.
    #[cfg(feature = "encryption")]
    pub fn with_config(config: &EncryptionConfig) -> SnapshotResult<Self> {
        let enc = DataEncryptor::new(config)?;
        Ok(Self::with_encryptor(enc))
    }

    /// Returns `true` when this store will actually encrypt payloads on disk.
    pub fn is_encrypted(&self) -> bool {
        #[cfg(feature = "encryption")]
        {
            self.encryptor.as_ref().map(|e| e.is_active()).unwrap_or(false)
        }
        #[cfg(not(feature = "encryption"))]
        {
            false
        }
    }

    /// Write `data` to `path`, encrypting it first when an active encryptor
    /// is configured.  The `ENCRYPTION_MAGIC` prefix is prepended to
    /// encrypted payloads so they can be detected on read.
    pub fn write_snapshot(&self, path: &Path, data: &[u8]) -> SnapshotResult<()> {
        #[cfg(feature = "encryption")]
        {
            if let Some(enc) = self.encryptor.as_ref() {
                if enc.is_active() {
                    let ciphertext = enc.encrypt(data)?;
                    let payload = with_magic(&ciphertext);
                    std::fs::write(path, &payload)?;
                    return Ok(());
                }
            }
            std::fs::write(path, data)?;
            Ok(())
        }

        #[cfg(not(feature = "encryption"))]
        {
            std::fs::write(path, data)?;
            Ok(())
        }
    }

    /// Read a snapshot from `path`, decrypting it if the magic prefix is
    /// detected.
    ///
    /// - Plaintext files (no magic prefix) are returned as-is.
    /// - Encrypted files are decrypted via the configured encryptor.  If the
    ///   file is encrypted but no encryptor is configured,
    ///   `SnapshotEncryptionError::EncryptedButNoEncryptor` is returned.
    pub fn read_snapshot(&self, path: &Path) -> SnapshotResult<Vec<u8>> {
        let bytes = std::fs::read(path)?;

        #[cfg(feature = "encryption")]
        {
            if let Some(ct) = strip_magic(&bytes) {
                let enc = self
                    .encryptor
                    .as_ref()
                    .ok_or(SnapshotEncryptionError::EncryptedButNoEncryptor)?;
                let plaintext = enc.decrypt(ct)?;
                return Ok(plaintext);
            }
            Ok(bytes)
        }

        #[cfg(not(feature = "encryption"))]
        {
            if is_encrypted_payload(&bytes) {
                return Err(SnapshotEncryptionError::EncryptedButNoEncryptor);
            }
            Ok(bytes)
        }
    }
}

#[cfg(test)]
mod encryption_snapshot_tests {
    use super::*;

    #[cfg(feature = "encryption")]
    #[test]
    fn snapshot_encrypt_decrypt_roundtrip() {
        let dir = std::env::temp_dir();
        let path = dir.join("zegion_persistence_enc_snapshot.bin");
        let original = b"snapshot blob: weights and training state";

        let store = SnapshotStore::with_config(&EncryptionConfig::enabled(
            "snapshot-passphrase",
        ))
        .expect("encrypted store builds");
        assert!(store.is_encrypted());

        store
            .write_snapshot(&path, original)
            .expect("write encrypted snapshot");

        // On-disk bytes must differ from plaintext and carry the magic prefix.
        let on_disk = std::fs::read(&path).expect("read raw file");
        assert!(is_encrypted_payload(&on_disk));
        assert_ne!(&on_disk[ENCRYPTION_MAGIC.len()..], original);

        let recovered = store
            .read_snapshot(&path)
            .expect("read + decrypt snapshot");
        assert_eq!(recovered, original.to_vec());

        let _ = std::fs::remove_file(&path);
    }

    #[test]
    fn plaintext_snapshot_roundtrip() {
        let dir = std::env::temp_dir();
        let path = dir.join("zegion_persistence_plain_snapshot.bin");
        let original = b"plaintext snapshot blob";

        let store = SnapshotStore::plaintext();
        assert!(!store.is_encrypted());

        store
            .write_snapshot(&path, original)
            .expect("write plaintext snapshot");
        let on_disk = std::fs::read(&path).expect("read raw file");
        assert!(!is_encrypted_payload(&on_disk));

        let recovered = store
            .read_snapshot(&path)
            .expect("read plaintext snapshot");
        assert_eq!(recovered, original.to_vec());

        let _ = std::fs::remove_file(&path);
    }

    #[cfg(feature = "encryption")]
    #[test]
    fn encrypted_file_without_encryptor_errors() {
        let dir = std::env::temp_dir();
        let path = dir.join("zegion_persistence_enc_no_decryptor.bin");

        // Write an encrypted file with one store...
        let writer = SnapshotStore::with_config(&EncryptionConfig::enabled(
            "writer-passphrase",
        ))
        .expect("writer store builds");
        writer
            .write_snapshot(&path, b"secret")
            .expect("write encrypted");

        // ...then try to read it with a plaintext store (no encryptor).
        let reader = SnapshotStore::plaintext();
        let res = reader.read_snapshot(&path);
        assert!(
            matches!(res, Err(SnapshotEncryptionError::EncryptedButNoEncryptor)),
            "expected EncryptedButNoEncryptor, got {res:?}"
        );

        let _ = std::fs::remove_file(&path);
    }
}
