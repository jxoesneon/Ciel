{"ts":"2026-08-01T03:22:16Z","hook":"PreToolUse","tool":"exec","decision":"approve","reason":"default allow","command":"cd /Users/mey/Zegion/datasets/pix3d && python3 -c "
import zipfile, struct, os

# Read the partial zip
with open('pix3d.zip', 'rb') as f:
    data = f.read()

print(f'Partial zip size: {len(data)} bytes')

# Try to find local file headers (PK\x03\x04)
offset = 0
files_found = []
while offset < len(data) - 4:
    sig = data[offset:offset+4]
    if sig == b'PK\x03\x04':
        # Local file header
        try:
            fname_len = struct.unpack('<H', data[offset+26:offset+28])[0]
            extra_len = struct.unpack('<H', data[offset+28:offset+30])[0]
            fname = data[offset+30:offset+30+fname_len].decode('utf-8', errors='replace')
            compressed_size = struct.unpack('<I', data[offset+18:offset+22])[0]
            compression = struct.unpack('<H', data[offset+8:offset+10])[0]
            files_found.append((fname, compressed_size, compression, offset))
            print(f'  Found: {fname} (compressed: {compressed_size}, method: {compression})')
            # Move past this entry
            data_start = offset + 30 + fname_len + extra_len
            offset = data_start + compressed_size
        except:
            offset += 1
    else:
        offset += 1

print(f'Total files found in partial zip: {len(files_found)}')
" 2>&1"}
