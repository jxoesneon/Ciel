U="/tmp/nro_updates/extracted/retroarch"

# Copy main RetroArch NRO
cp "$U/switch/retroarch_switch.nro" "$SD/switch/retroarch_switch.nro" && echo "RetroArch main: OK" || echo "RetroArch main: FAIL"

# Copy all cores - the new release has many more cores than what's installed
# First, let's see what cores are in the new release
echo "=== New cores count ==="
find "$U/retroarch/cores" -name "*.nro" | wc -l
echo "=== Currently installed cores ==="
find "$SD/retroarch/cores" -name "*.nro" -not -name "._*" | wc -l

# Copy all new cores (overwrites existing ones with newer versions)
echo "=== Copying cores ==="
cp -R "$U/retroarch/cores/"* "$SD/retroarch/cores/" 2>&1 | tail -3 && echo "RetroArch cores: OK" || echo "RetroArch cores: PARTIAL"

# Copy any additional RetroArch files (configs, assets, etc.)
if [ -d "$U/retroarch/assets" ]; then
    mkdir -p "$SD/retroarch/assets"
    cp -R "$U/retroarch/assets/"* "$SD/retroarch/assets/" 2>/dev/null && echo "RetroArch assets: OK" || echo "RetroArch assets: PARTIAL"
fi
if [ -d "$U/retroarch/config" ]; then
    mkdir -p "$SD/retroarch/config"
    cp -R "$U/retroarch/config/"* "$SD/retroarch/config/" 2>/dev/null && echo "RetroArch config: OK"
fi
if [ -d "$U/retroarch/info" ]; then
    mkdir -p "$SD/retroarch/info"
    cp -R "$U/retroarch/info/"* "$SD/retroarch/info/" 2>/dev/null && echo "RetroArch info: OK"
fi
if [ -d "$U/retroarch/saves" ]; then
    mkdir -p "$SD/retroarch/saves"
