echo "SaltyNX v1.8.1 (0000000000534C56) - game plugins"
echo "aura_nx (4200000000000012) - audio"
echo "pad-macro (0100000000C0FFEE) - pad macros"
echo "Ultrahand ovlmenu (420000000007E51B) - overlay menu""}
