import re

with open('/tmp/draft_datacite.txt') as f: datacite = f.read()
with open('/tmp/draft_crossref.txt') as f: crossref = f.read()
with open('/tmp/draft_figshare.txt') as f: figshare = f.read()
with open('/tmp/draft_dryad.txt') as f: dryad = f.read()
with open('/tmp/draft_ckan.txt') as f: ckan = f.read()

def extract_ts_functions(draft):
    """Extract TS function code between the section markers."""
    # Find Section 2 content
    parts = draft.split('===SECTION')
    if len(parts) < 3:
        return None
    # Section 2 is the second ===SECTION block
    section2 = parts[2]
    # Remove the section header line
    lines = section2.split('\n')
    # Skip header lines (=== and --- lines)
    code_lines = []
    in_code = False
    for line in lines:
        if line.strip().startswith('---') or line.strip().startswith('==='):
            continue
        if 'function map' in line or 'function search' in line or 'const ' in line and ('PAGE_SIZE' in line or 'MAX_PAGES' in line or 'BASE' in line):
            in_code = True
        if in_code:
            code_lines.append(line)
    return '\n'.join(code_lines).strip()

def extract_ts_types(draft):
    """Extract TS type interfaces from Section 3."""
    parts = draft.split('===SECTION')
    if len(parts) < 4:
        return None
    section3 = parts[3]
    # Extract export interface blocks
    interfaces = re.findall(r'export interface \w+ \{[^}]*\}', section3, re.DOTALL)
    return '\n\n'.join(interfaces)

def extract_federation_node(draft):
    """Extract the federation node entry from Section 4."""
    parts = draft.split('===SECTION')
    if len(parts) < 5:
        return None
    section4 = parts[4]
    # Find the { id: ... } block
    match = re.search(r'\{\s*id:\s*[\x27"][^\x27"]+[\x27"].*?\}', section4, re.DOTALL)
    return match.group(0) if match else None

# Test extraction
print("=== DataCite TS functions ===")
dc_ts = extract_ts_functions(datacite)
print(dc_ts[:200] if dc_ts else "FAILED")
print()
print("=== DataCite TS types ===")
dc_types = extract_ts_types(datacite)
print(dc_types[:200] if dc_types else "FAILED")
print()
print("=== DataCite federation node ===")
dc_node = extract_federation_node(datacite)
print(dc_node[:200] if dc_node else "FAILED")

PYEOF"}
