echo "=== UNWRAP in non-test code (more precise) ==="
# Count unwraps that are NOT inside #[cfg(test)] modules or test files
for f in $(find crates/ -name "*.rs" | grep -v "test"); do
  # Get unwraps that are outside test modules
  grep -n "\.unwrap()" "$f" 2>/dev/null | while read line; do
    lineno=$(echo "$line" | cut -d: -f1)
    # Check if this line is inside a test module by looking backwards for #[cfg(test)]
    before=$(head -n "$lineno" "$f" | grep -c "#\[cfg(test)\]")
    if [ "$before" -eq 0 ]; then
      echo "$f:$line"
    fi
  done
done 2>/dev/null | head -30
echo "---"
echo "=== KEY MANAGER ENCRYPTION ==="
grep -n "aes\|encrypt\|decrypt\|XOR\|placeholder" crates/zegion-core/src/safety/key_manager.rs | head -10
