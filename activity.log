new_openml = '''/// Probe for the OpenML public API with limit/offset pagination.
///
/// Uses the JSON endpoint with `limit/{n}/offset/{m}` path segments to
/// fetch up to 1000 results in batches of 1000.
pub struct OpenMLProbe;
impl ResolutionProbe for OpenMLProbe {
    fn name(&self) -> &str {
        "OpenML"
    }
    fn probe(
        &self,
        client: &reqwest::blocking::Client,
        guard: &ScrapingGuard,
        query: &str,
    ) -> Result<Vec<ResolvedDataset>> {
        let mut all_results: Vec<ResolvedDataset> = Vec::new();
        let batch_size = 1000usize;

        // Safety bound: max 5 batches (up to 5000 results).
        for batch in 0..5 {
            let offset = batch * batch_size;
            let url = format!(
                "https://www.openml.org/api/v1/json/data/list/limit/{}/offset/{}/data_name/{}",
                batch_size, offset, query
            );
            if !validate_url(guard, &url)? {
                break;
            }
            let resp: serde_json::Value = client.get(&url).send()?.json()?;

            let datasets = match resp["data"]["dataset"].as_array() {
                Some(arr) => arr,
                None => break,
            };
            if datasets.is_empty() {
                break;
            }

            for d in datasets {
                all_results.push(ResolvedDataset {
                    source: self.name().to_string(),
                    id: format!("openml-{}", d["did"]),
                    title: sanitize_title(d["name"].as_str().unwrap_or("unknown")),
                    author: sanitize_author("OpenML Community"),
                    relevance_score: d["NumberOfInstances"]
                        .as_str()
                        .and_then(|s| s.parse().ok())
                        .unwrap_or(0),
                    relevance_score_label: "Instances".to_string(),
