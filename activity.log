import json
with open('/Users/meilynlopezcubero/.gemini/antigravity/brain/2041938c-35f0-4222-aeae-ef17496d6669/.system_generated/logs/transcript.jsonl') as f:
    lines = f.readlines()
print(f'Total lines: {len(lines)}')
for i in range(200, len(lines)):
    data = json.loads(lines[i])
    print(f'Line {i} - Step {data.get(\"step_index\")} - Type: {data.get(\"type\")} - Source: {data.get(\"source\")}')
    if data.get('type') == 'USER_INPUT':
        print(f'   USER INPUT: {data.get(\"content\")[:150]}...')
    elif data.get('type') == 'PLANNER_RESPONSE':
        print(f'   PLANNER THINKING: {data.get(\"thinking\")[:150]}...')
        if data.get('tool_calls'):
            print(f'   TOOL CALLS: {[tc.get(\"name\") for tc in data[\"tool_calls\"]]}')
""}
