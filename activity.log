new_func = '''/// Stream HuggingFace results with cursor-based pagination.
///
/// HF caps each request at 1000 results. For queries that match more, we
/// follow the `Link: rel="next"` cursor header to fetch additional pages,
/// sending each batch as a separate SSE event. The `offset` parameter is
/// silently ignored by HF's API, so cursor-based pagination is required.
async fn stream_huggingface(
    tx: mpsc::Sender<StreamEvent>,
    query: String,
    filters: SearchFilters,
    limit: usize,
) {
    let client = match reqwest::Client::builder().timeout(HTTP_TIMEOUT).build() {
        Ok(c) => c,
        Err(e) => {
            let _ = tx
                .send(StreamEvent::ProviderError {
                    source: "huggingface".into(),
                    error: format!("HTTP client build failed: {}", e),
                    partial_count: 0,
                })
                .await;
            return;
        }
    };

    let (sort_field, direction) = hf_sort_params(filters.sort.as_deref());
    let tags = parse_tags(filters.tags.as_deref());
    let filter_str: String = tags
        .iter()
        .map(|t| format!("modality:{}", t))
        .collect::<Vec<_>>()
        .join(",");

    let mut cumulative = 0usize;
    let mut truncated = false;
    let page_size = limit.min(1000);
    let mut url: Option<String> = Some(build_hf_search_url(
        &query,
        page_size,
        sort_field,
        direction,
        &filter_str,
    ));

    // Safety bound: max 5 paginated requests (up to 5000 results).
    for _page in 0..5 {
        let current_url = match url.take() {
            Some(u) => u,
            None => break,
        };

        let remaining = limit.saturating_sub(cumulative);
        if remaining == 0 {
            truncated = cumulative >= MAX_RESULTS_PER_PROVIDER;
            break;
        }

        let resp = match client
            .get(&current_url)
            .header("Accept", "application/json")
            .send()
            .await
        {
            Ok(r) => r,
            Err(e) => {
                let _ = tx
                    .send(StreamEvent::ProviderError {
                        source: "huggingface".into(),
                        error: format!("Request failed: {}", e),
                        partial_count: cumulative,
                    })
                    .await;
                return;
            }
        };

        if !resp.status().is_success() {
            let _ = tx
                .send(StreamEvent::ProviderError {
                    source: "huggingface".into(),
                    error: format!("HTTP {}", resp.status()),
                    partial_count: cumulative,
                })
                .await;
            return;
        }

        // Extract the next-page cursor from the Link header before consuming the body.
        let next_url = parse_hf_next_link(
            resp.headers().get("link").and_then(|v| v.to_str().ok()),
        );

        let items: Vec<HfDataset> = match resp.json().await {
            Ok(v) => v,
            Err(e) => {
                let _ = tx
                    .send(StreamEvent::ProviderError {
                        source: "huggingface".into(),
                        error: format!("JSON parse failed: {}", e),
                        partial_count: cumulative,
                    })
                    .await;
                return;
            }
        };

        let batch_count = items.len();
        if batch_count == 0 {
            break;
        }

        let results: Vec<DatasetSearchResult> = items.into_iter().map(map_hf_dataset).collect();

        // Enrich results with sizes from the datasets-server before sending.
        let results = enrich_sizes(results).await;

        cumulative += batch_count;
        let _ = tx
            .send(StreamEvent::Batch {
                results,
                source: "huggingface".into(),
                batch_count,
                cumulative_count: cumulative,
            })
            .await;

        // Follow the cursor to the next page.
        url = next_url;

        // If we got fewer than requested, no more results.
        if batch_count < page_size {
            break;
        }
    }

    if truncated {
        let _ = tx
            .send(StreamEvent::Truncated {
                source: "huggingface".into(),
                cap: MAX_RESULTS_PER_PROVIDER,
            })
            .await;
    }
}'''

