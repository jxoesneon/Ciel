import ftplib
from io import BytesIO

ftp = ftplib.FTP()
ftp.connect('192.168.100.72', 5000, timeout=10)
ftp.login('anonymous', '')
ftp.set_pasv(True)

# Read current hekate_ipl.ini
lines = []
ftp.retrlines('RETR /bootloader/hekate_ipl.ini', lines.append)
original = '\r\n'.join(lines)

# Backup
try:
    ftp.rename('/bootloader/hekate_ipl.ini', '/bootloader/hekate_ipl.ini.bak')
    print("Backed up hekate_ipl.ini")
except:
    print("Backup already exists or failed")

# Add kip1=atmosphere/kips/hoc.kip to CFW entries
# We need to add it after the fss0 line in each CFW entry
updated = original

# For [CFW (SYSNAND)] - add kip1 after fss0 line
updated = updated.replace(
    'fss0=atmosphere/package3\r\natmosphere=1\r\nlogopath=bootloader/bootlogo.bmp\r\nicon=bootloader/res/icon_payload.bmp\r\n{}\r\n\r\n[CFW (EMUMMC)]',
    'fss0=atmosphere/package3\r\nkip1=atmosphere/kips/hoc.kip\r\natmosphere=1\r\nlogopath=bootloader/bootlogo.bmp\r\nicon=bootloader/res/icon_payload.bmp\r\n{}\r\n\r\n[CFW (EMUMMC)]'
)

# For [CFW (EMUMMC)] - add kip1 after fss0 line
updated = updated.replace(
    'fss0=atmosphere/package3\r\natmosphere=1\r\nlogopath=bootloader/bootlogo.bmp\r\nicon=bootloader/res/icon_payload.bmp\r\n{}\r\n\r\n{--- Stock ---}',
    'fss0=atmosphere/package3\r\nkip1=atmosphere/kips/hoc.kip\r\natmosphere=1\r\nlogopath=bootloader/bootlogo.bmp\r\nicon=bootloader/res/icon_payload.bmp\r\n{}\r\n\r\n{--- Stock ---}'
)

# Check if replacement worked
if 'kip1=atmosphere/kips/hoc.kip' in updated:
    print("kip1 line added successfully")
else:
    print("WARNING: Replacement didn't match, trying alternative...")
    # Try with \n instead of \r\n
    original_lf = original.replace('\r\n', '\n')
    updated = original_lf.replace(
        'fss0=atmosphere/package3\natmosphere=1\nlogopath=bootloader/bootlogo.bmp\nicon=bootloader/res/icon_payload.bmp\n{}\n\n[CFW (EMUMMC)]',
        'fss0=atmosphere/package3\nkip1=atmosphere/kips/hoc.kip\natmosphere=1\nlogopath=bootloader/bootlogo.bmp\nicon=bootloader/res/icon_payload.bmp\n{}\n\n[CFW (EMUMMC)]'
    )
    updated = updated.replace(
        'fss0=atmosphere/package3\natmosphere=1\nlogopath=bootloader/bootlogo.bmp\nicon=bootloader/res/icon_payload.bmp\n{}\n\n{--- Stock ---}',
        'fss0=atmosphere/package3\nkip1=atmosphere/kips/hoc.kip\natmosphere=1\nlogopath=bootloader/bootlogo.bmp\nicon=bootloader/res/icon_payload.bmp\n{}\n\n{--- Stock ---}'
    )
    if 'kip1=atmosphere/kips/hoc.kip' in updated:
        print("kip1 line added (LF version)")
    else:
        print("FAILED to add kip1")

# Upload updated hekate_ipl.ini
data = updated.encode('utf-8')
ftp.storbinary('STOR /bootloader/hekate_ipl.ini', BytesIO(data))
print(f"Uploaded updated hekate_ipl.ini ({len(data)} bytes)")

# Verify by reading back
verify_lines = []
ftp.retrlines('RETR /bootloader/hekate_ipl.ini', verify_lines.append)
print("\n=== Verified hekate_ipl.ini ===")
for line in verify_lines:
    print(line)

ftp.quit()
PYEOF"}
