{"ts":"2026-08-02T16:19:27Z","hook":"PreToolUse","tool":"exec","decision":"approve","reason":"network call (auto-approved, user full-autonomy grant)","command":"# Verify Hekate version in the new update.bin
python3 << 'PYEOF'
import re

with open('/Volumes/SWITCH/bootloader/update.bin', 'rb') as f:
    data = f.read()

for m in re.finditer(rb'hekate\s+[Vv]?(\d+\.\d+\.\d+)', data):
    print(f"Hekate version: {m.group(0).decode()}")
    break

# Check Atmosphere version - look in package3
with open('/Volumes/SWITCH/atmosphere/package3', 'rb') as f:
    data = f.read()
for m in re.finditer(rb'(1\.\d+\.\d+)', data):
    start = max(0, m.start() - 20)
    end = min(len(data), m.end() + 20)
    ctx = data[start:end]
    if all(c < 128 or c == 0 for c in ctx):
        ctx_str = ctx.replace(b'\x00', b' ').decode('ascii', errors='replace').strip()
        if not any(x in ctx_str for x in ['curl', 'glfw', 'mesa', 'newlib', 'SDL']):
            print(f"Atmosphere: {ctx_str}")
            break

# Verify fusee version
with open('/Volumes/SWITCH/bootloader/payloads/fusee.bin', 'rb') as f:
    data = f.read()
for m in re.finditer(rb'(1\.\d+\.\d+)', data):
    start = max(0, m.start() - 20)
    end = min(len(data), m.end() + 20)
    ctx = data[start:end]
    if all(c < 128 or c == 0 for c in ctx):
        ctx_str = ctx.replace(b'\x00', b' ').decode('ascii', errors='replace').strip()
        if not any(x in ctx_str for x in ['curl', 'glfw', 'mesa', 'newlib', 'SDL']):
            print(f"fusee: {ctx_str}")
            break

# Check hbmenu version
with open('/Volumes/SWITCH/hbmenu.nro', 'rb') as f:
    data = f.read()
base = data.find(b'NRO0')
d = data[base:]
for m in re.finditer(rb'(3\.\d+\.\d+)', d):
    start = max(0, m.start() - 20)
    end = min(len(d), m.end() + 20)
    ctx = d[start:end].replace(b'\x00', b' ').decode('ascii', errors='replace').strip()
    print(f"hbmenu: {ctx}")
    break
PYEOF"}
