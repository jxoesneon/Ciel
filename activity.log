with open('model.rs', 'r') as f:
    content = f.read()

old = '''/// Record type for [\`Reconstruction3DModel\`].
#[derive(burn::record::Record)]
pub struct Reconstruction3DModelRecord<B: Backend> {
    pub encoder: <ZegionModel<B> as Module<B>>::Record,
    pub decoder: <VoxelDecoder3D<B> as Module<B>>::Record,
    pub projection: Option<<Linear<B> as Module<B>>::Record>,
}'''

new = '''/// Type alias for the projection layer'\''s module record.
type ProjectionRecord<B> = <Linear<B> as Module<B>>::Record;

/// Record type for [\`Reconstruction3DModel\`].
#[derive(burn::record::Record)]
pub struct Reconstruction3DModelRecord<B: Backend> {
    pub encoder: <ZegionModel<B> as Module<B>>::Record,
    pub decoder: <VoxelDecoder3D<B> as Module<B>>::Record,
    pub projection: Option<ProjectionRecord<B>>,
}'''

if old in content:
    content = content.replace(old, new)
    with open('model.rs', 'w') as f:
        f.write(content)
    print('Replaced successfully')
else:
    print('Old string not found')
""}
