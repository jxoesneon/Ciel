new_func = '''async fn search_kaggle(
    query: String,
    filters: SearchFilters,
    limit: usize,
) -> Vec<DatasetSearchResult> {
    let client = match reqwest::Client::builder().timeout(HTTP_TIMEOUT).build() {
        Ok(c) => c,
        Err(e) => {
            tracing::warn!("Kaggle: failed to build HTTP client: {}", e);
            return Vec::new();
        }
    };

    let sort_by = kaggle_sort_param(filters.sort.as_deref());
    let tags = parse_tags(filters.tags.as_deref());

    // Build tag/filter suffix once.
    let mut filter_suffix = String::new();
    for tag in &tags {
        match tag.as_str() {
            "tabular" | "text" => {
                if !filter_suffix.contains("fileType=") {
                    filter_suffix.push_str("&fileType=csv");
                }
            }
            _ => {
                if !filter_suffix.contains("tagIds=") {
                    filter_suffix.push_str(&format!("&tagIds={}", urlencode(tag)));
                }
            }
        }
    }

    let page_size = 200usize; // Kaggle max per page
    let max_pages = limit.div_ceil(page_size).min(25); // safety bound: 25 pages = 5000
    let mut results: Vec<DatasetSearchResult> = Vec::new();

    for page in 1..=max_pages {
        let remaining = limit.saturating_sub(results.len());
        if remaining == 0 {
            break;
        }

        let url = format!(
            "https://www.kaggle.com/api/v1/datasets/list?search={}&page={}&page_size={}&sortBy={}{}",
            urlencode(&query),
            page,
            page_size,
            sort_by,
            filter_suffix,
        );

        let resp = match client
            .get(&url)
            .header("Accept", "application/json")
            .send()
            .await
        {
            Ok(r) => r,
            Err(e) => {
                tracing::warn!("Kaggle: request failed (page {}): {}", page, e);
                break;
            }
        };

        if !resp.status().is_success() {
            tracing::warn!("Kaggle: HTTP {} (page {})", resp.status(), page);
            break;
        }

        // Kaggle returns a bare JSON array.
        let body: Vec<KaggleDataset> = match resp.json().await {
            Ok(v) => v,
            Err(e) => {
                tracing::warn!("Kaggle: JSON parse failed (page {}): {}", page, e);
                break;
            }
        };

        let batch_count = body.len();
        if batch_count == 0 {
            break;
        }

        for d in body {
            results.push(map_kaggle_dataset(d));
            if results.len() >= limit {
                break;
            }
        }

        // If we got fewer than a full page, no more results.
        if batch_count < page_size {
            break;
        }
    }

    if results.len() > limit {
        results.truncate(limit);
    }
    results
}'''

