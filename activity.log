path = '/Volumes/SWITCH/switch/DBI_ENG/DBI.nro'
with open(path, 'rb') as f:
    data = f.read()

base = data.find(b'NRO0')
d = data[base:]

# Search for format strings near "DBI: " - look for %s or %d patterns
import re
# The "DBI: " at 0x498f90 is followed by null, so the version is likely 
# constructed at runtime. Let's look for a version format string
# DBI uses a version like "v658" - search for patterns like "v%d" or "%d"
for m in re.finditer(rb'v%[ds]', d):
    start = max(0, m.start() - 20)
    end = min(len(d), m.end() + 20)
    ctx = d[start:end].replace(b'\x00', b' ').decode('ascii', errors='replace')
    print(f"  0x{m.start():x}: {ctx}")

# Also search for "Version:" or "ver:" patterns
for m in re.finditer(rb'[Vv]ersion[:\s]*%[ds]', d):
    start = max(0, m.start() - 10)
    end = min(len(d), m.end() + 20)
    ctx = d[start:end].replace(b'\x00', b' ').decode('ascii', errors='replace')
    print(f"  0x{m.start():x}: {ctx}")

# Check the NACP more carefully - maybe the title is at a different offset
aset_idx = d.find(b'ASET')
if aset_idx != -1:
    nacp_off = int.from_bytes(d[aset_idx+24:aset_idx+32], 'little')
    nacp_size = int.from_bytes(d[aset_idx+32:aset_idx+40], 'little')
    nacp_abs = aset_idx + nacp_off
    print(f"\nNACP at 0x{nacp_abs:x}, size 0x{nacp_size:x}")
    # Dump first 0x400 bytes of NACP
    print("NACP first 0x400 bytes (strings):")
    chunk = d[nacp_abs:min(nacp_abs+0x400, len(d))]
    current = b''
    for i, b in enumerate(chunk):
        if 32 <= b < 127:
            current += bytes([b])
        else:
            if len(current) >= 2:
                print(f"  +0x{i-len(current):x}: {current.decode('ascii')}")
            current = b''
    
    # Check version field
    if nacp_abs + 0x3010 <= len(d):
        ver_field = d[nacp_abs+0x3000:nacp_abs+0x3010]
        print(f"\nVersion field (0x3000): {ver_field.hex(' ')}")
        print(f"  as string: '{ver_field.split(b chr(0))[0]}'".replace('chr(0)', '\\x00'))
